namespace L1 { // "Cloud" — up to six cloud heads of 16 soft dabs each, drifting right on the wind
  // knobVal[0] Bloom = how many heads (a head shows while its threshold <= Bloom),
  // knobVal[1] CloudSize = scale, knobVal[2] Wind = drift speed. K1 press = gust.
  constexpr int L1_CLOUD_N = 6;
  constexpr int L1_DAB_N = 16;
  // JS maxCloudY = min(h, floor(h * 0.52)) = 66 for h = 128: the only rows this layer paints.
  constexpr int L1_ROWS = (FRAME_H * 52) / 100;
  constexpr int L1_BUF_N = FRAME_W * L1_ROWS;
  constexpr float L1_TWENTY_PI = 62.8318531f; // 20π: a dab phase feeds cos(p), sin(1.3p), sin(1.4p) only
  constexpr float L1_SPAN = 2.0f;             // the wrap span (-0.5 .. 1.5), also wind's exact period
  constexpr float L1_MIN_X = -0.5f;
  constexpr float L1_JITTER = 1.0f + (-1.671f) * 0.3f; // 0.4987, a constant in the JS

  struct Cloud { float x, y, threshold, baseTone, alphaRate; };
  struct Dab { float ox, oy, rx, ry, phase, pulseFreq; };

  // parentClouds, as written in the JS: x, y, threshold, baseTone, alphaRate.
  static const Cloud CLOUDS[L1_CLOUD_N] = {
    { -0.15f, 0.17f, 1.0f, 0.95f, 0.62f }, // thick, bright white
    {  0.15f, 0.24f, 2.0f, 0.72f, 0.44f }, // thin and soft
    {  0.45f, 0.16f, 3.0f, 0.86f, 0.55f }, // mid tone
    {  0.75f, 0.25f, 4.0f, 0.92f, 0.60f }, // big and full
    {  1.05f, 0.18f, 5.0f, 0.68f, 0.42f }, // faint, see-through
    {  1.35f, 0.23f, 6.0f, 0.82f, 0.50f }  // natural mid
  };

  // The JS builds the dabs in setup() from hash(n) = fract(sin(n * 127.1) * 43758.5453)
  // in double precision. In float32 that hash lands somewhere else entirely (the sine
  // of ~27000 rad), so the finished table is baked here instead: generated by running
  // the layer's own setup() in node, none of it typed by hand. 2.3 KB of flash.
@@DABS@@

  // Per-dab phase accumulators (the JS dab.p, starting at dab.phase). 384 B.
  static float p[L1_CLOUD_N * L1_DAB_N];
  static float wind = 0.0f;
  static float gustTarget = 0.0f; // K1 press gust target; 0 on the idle return
  static float gust = 0.0f;       // gust strength 0..1; 0 on the idle return
  static float stretch = 1.0f;    // 1 + 0.3 gust, recomputed every frame
  static float count = 5.25f;
  static float scale = 1.7f;

  // One frame's scratch over the 66 painted rows.
  // exhibit: 16.9 KB + 2 x 4.2 KB, so PFMem (PSRAM-first, once in setup).
  static float* trans = nullptr;     // remaining transparency: product of (1 - dab alpha)
  static uint8_t* toneIdx = nullptr; // the JS toneBuf (brightest baseTone that touched the
                                     // pixel) as the index of that cloud: same values, 1/4 the RAM
  static uint8_t* counts = nullptr;  // dabs that touched the pixel, capped at 8

  static inline int iceil(float x) { return -PFMath::ifloor(-x); }

  void setup() {
    PFMath::buildSinLUT();
    if (!trans) trans = PFMem::allocFloats(L1_BUF_N);
    if (!toneIdx) toneIdx = (uint8_t*)PFMem::alloc(L1_BUF_N);
    if (!counts) counts = (uint8_t*)PFMem::alloc(L1_BUF_N);
    for (int i = 0; i < L1_CLOUD_N * L1_DAB_N; i++) p[i] = DABS[i].phase;
    wind = 0.0f;
    gustTarget = 0.0f;
    gust = 0.0f;
    stretch = 1.0f;
  }

  void update(float dt, const InputFrame& input) {
    // K1 press: gust. The flower layer runs the same formula on the same input, so the
    // two always hold the same value. gustTarget jumps to 1 and falls 0.45/s to 0 (it
    // stops there - nothing accumulates); gust follows it with a ~0.14 s time constant.
    // A press during a gust only puts gustTarget back to 1.
    if (input.btnPressed[0]) gustTarget = 1.0f;
    gustTarget -= dt * 0.45f;
    if (gustTarget < 0.0f) gustTarget = 0.0f;
    float follow = dt * 7.0f;
    if (follow > 1.0f) follow = 1.0f;
    gust += (gustTarget - gust) * follow;
    if (gustTarget == 0.0f && gust < 0.001f) gust = 0.0f;

    // The gust adds to the drift speed rather than multiplying it.
    wind += dt * (knobVal[2] * 0.11f + gust * 0.4f);
    // wind is only used inside the 2.0 span: 2.0 is exactly one lap.
    if (wind >= L1_SPAN) wind -= L1_SPAN;

    // A phase per dab (pulseFreq differs per dab, so one shared clock would not wrap);
    // the gust speeds the billowing up too.
    const float rate = dt * 1.1f;
    const float gustMul = 1.0f + 2.0f * gust;
    for (int i = 0; i < L1_CLOUD_N * L1_DAB_N; i++) {
      p[i] += rate * DABS[i].pulseFreq * gustMul;
      if (p[i] >= L1_TWENTY_PI) p[i] -= L1_TWENTY_PI;
    }
    count = knobVal[0];
    scale = knobVal[1];
    stretch = 1.0f + 0.3f * gust; // the gust stretches the clouds sideways (1 .. 1.3)
  }

  void draw() {
    if (!trans || !toneIdx || !counts) return;
    // The JS resets trans = 1, tone = 0 and counts = 0 every frame. Only counts is
    // cleared here: the first dab to touch a pixel writes trans = 1 - alpha and its
    // cloud as the tone, exactly what 1 * (1 - alpha) and max(0, baseTone) give.
    memset(counts, 0, L1_BUF_N);

    const float fW = (float)FRAME_W;
    const float fH = (float)FRAME_H;
    const float invW = 1.0f / (float)(FRAME_W - 1);
    const float invH = 1.0f / (float)(FRAME_H - 1);
    const float sqrtScale = sqrtf(scale);
    const float sx = L1_JITTER * scale * stretch;
    const float sy = L1_JITTER * scale;
    int rowLo = L1_ROWS, rowHi = -1; // the rows any dab touched this frame

    for (int c = 0; c < L1_CLOUD_N; c++) {
      const Cloud& cloud = CLOUDS[c];
      if (cloud.threshold > count) continue;

      // JS: ((x + wind - minX) % span), + span if negative, + minX. The dividend stays
      // in 0.35 .. 3.85.
      float cx = PFMath::jsMod(cloud.x + wind - L1_MIN_X, L1_SPAN);
      if (cx < 0.0f) cx += L1_SPAN;
      cx += L1_MIN_X;

      const float alphaRate = cloud.alphaRate;
      const float baseTone = cloud.baseTone;
      const Dab* dabs = DABS + c * L1_DAB_N;
      const float* ph = p + c * L1_DAB_N;

      for (int d = 0; d < L1_DAB_N; d++) {
        const Dab& dab = dabs[d];
        const float pp = ph[d];
        const float driftX = PFMath::fastCos(pp) * 0.007f;
        const float driftY = PFMath::fastSin(pp * 1.3f) * 0.004f;
        const float dabPosX = cx + (dab.ox + driftX) * sx;
        const float dabPosY = cloud.y + (dab.oy + driftY) * sy;

        const float sizePulse = 1.0f + PFMath::fastSin(pp * 1.4f) * 0.10f;
        const float rX = dab.rx * sqrtScale * sizePulse * stretch;
        const float rY = dab.ry * sqrtScale * sizePulse;

        const int minPxX = PFMath::ifloor((dabPosX - rX) * fW);
        const int maxPxX = iceil((dabPosX + rX) * fW);
        const int minPxY = PFMath::ifloor((dabPosY - rY) * fH);
        const int maxPxY = iceil((dabPosY + rY) * fH);
        if (maxPxX < 0 || minPxX >= FRAME_W || maxPxY < 0 || minPxY >= L1_ROWS) continue;

        const int x0 = minPxX < 0 ? 0 : minPxX;
        const int x1 = maxPxX > FRAME_W - 1 ? FRAME_W - 1 : maxPxX;
        const int y0 = minPxY < 0 ? 0 : minPxY;
        const int y1 = maxPxY > L1_ROWS - 1 ? L1_ROWS - 1 : maxPxY;

        const float invRxSq = 1.0f / (rX * rX);
        const float invRySq = 1.0f / (rY * rY);

        for (int py = y0; py <= y1; py++) {
          const float dy = (float)py * invH - dabPosY;
          const float dySqNorm = (dy * dy) * invRySq;
          if (dySqNorm >= 1.0f) continue;
          if (py < rowLo) rowLo = py;
          if (py > rowHi) rowHi = py;
          const int rowOffset = py * FRAME_W;
          for (int px = x0; px <= x1; px++) {
            const float dx = (float)px * invW - dabPosX;
            const float distNorm = (dx * dx) * invRxSq + dySqNorm;
            if (distNorm < 1.0f) {
              const int idx = rowOffset + px;
              const float alpha = (1.0f - distNorm) * alphaRate;
              const uint8_t n = counts[idx];
              if (n == 0) {
                trans[idx] = 1.0f - alpha;
                toneIdx[idx] = (uint8_t)c;
                counts[idx] = 1;
              } else {
                trans[idx] *= (1.0f - alpha);
                if (baseTone > CLOUDS[toneIdx[idx]].baseTone) toneIdx[idx] = (uint8_t)c;
                if (n < 8) counts[idx] = (uint8_t)(n + 1);
              }
            }
          }
        }
      }
    }

    // Final pass. The JS writes 0.0 to every untouched pixel and to the rows below the
    // clouds. The scaffold has already cleared this layer to zero bytes, which is what
    // 0.0 paints while ramp(0.0) is transparent black (it is, in this ramp), so only the
    // touched pixels are written. Should the ramp ever change, paint 0.0 as the JS does.
    if (L1_RAMP[0][0] | L1_RAMP[0][1] | L1_RAMP[0][2] | L1_RAMP[0][3])
      for (int y = 0; y < FRAME_H; y++)
        for (int x = 0; x < FRAME_W; x++) L1_setValue(x, y, 0.0f);
    for (int py = rowLo; py <= rowHi; py++) {
      const float ny = (float)py * invH;
      // The clouds fade out over ny 0.40 .. 0.52 (1 / 0.12 = 8.33).
      float falloff = 1.0f;
      if (ny > 0.40f) {
        falloff = 1.0f - (ny - 0.40f) * 8.33f;
        if (falloff < 0.0f) falloff = 0.0f;
      }
      const int rowOffset = py * FRAME_W;
      for (int px = 0; px < FRAME_W; px++) {
        const int idx = rowOffset + px;
        const uint8_t cNum = counts[idx];
        if (cNum == 0) continue;
        const float densityVal = 1.0f - trans[idx];
        const float layerSheen = (float)cNum * 0.025f;
        L1_setValue(px, py, (densityVal * CLOUDS[toneIdx[idx]].baseTone + layerSheen) * falloff);
      }
    }
  }
}
