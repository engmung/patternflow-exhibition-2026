# Patternflow Director — local Mosquitto (LAN-trust only)
# TCP for panels, WebSockets for the Director PWA in the browser.
#
# Start (example):
#   mosquitto -c mosquitto.conf.example -v
#
# Windows service installs may use a different conf path — merge these listeners.

listener 1883
protocol mqtt

listener 9001
protocol websockets

allow_anonymous true

# Optional: bind explicitly (default is all interfaces — fine on a trusted LAN)
# bind_address 0.0.0.0
