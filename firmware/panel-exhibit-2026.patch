+// ── Set once in setup(), before the network task exists ──────────────────
+inline bool rangeOk = false;     // the rows really are presetPatterns[]'s tail
+inline int  firstIdx = -1;       // registry index of the first exhibit pattern
+inline int  defaultIdx = -1;     // registry index of the default one
+
+// ── Frame task ──────────────────────────────────────────────────────────
