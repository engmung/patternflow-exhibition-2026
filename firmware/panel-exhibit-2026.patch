+          }
+          break;
+        case Fate::ByeEarly: react(rtp.ended(hostSsrc), t); break;
+      }
+    }
+    // inviteIfDue().
+    if (restart || rtp.size() > 0) continue;
+    if (!Rtp::inviteDue(clock, t, k.period) || !rtp.mayInvite(host, t)) continue;
+    assert(!open && "a second invitation to the host while the library may still try the first");
+    clock = t;
+    rtp.invited(host, t);
+    ++run.invites;
+    if (waiting) {
+      uint32_t& worst = waitingSilent ? run.worstAfterSilent : run.worstAfterReported;
+      worst = std::max(worst, t - waitingSince);
+      waiting = false;
+    }
+    // Its fate, on the library's timeline: the first attempt on the next
+    // pass, the others 1001 ms apart, the give-up 1001 ms after the last.
+    open = true; openedAt = t;
