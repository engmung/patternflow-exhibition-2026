+using PatternflowMidiRtp::session;
+static uint32_t initiatorsToHost() {
+  uint32_t n = 0;
+  for (size_t i = 0; i < session.participants.size(); ++i) {
+    const auto& p = session.participants[i];
+    if (p.kind == appleMidi::Initiator && (uint32_t)p.remoteIP == FL_IP) ++n;
+  }
+  return n;
+}
+static bool connectedToHost() {
+  for (size_t i = 0; i < session.participants.size(); ++i) {
+    const auto& p = session.participants[i];
+    if (p.kind == appleMidi::Initiator && (uint32_t)p.remoteIP == FL_IP && p.invitationStatus == appleMidi::Connected)
+      return true;
+  }
+  return false;
+}
+static int peers() { return PatternflowMidiRtp::peers.load(); }
+
+// The core's Wi-Fi task, as far as the self-heal sees it: a reconnect asked
+// for drops the link half a second later and brings it back `rejoinMs` after
+// that, and the connect edge reaches the feature (onNetwork -> networkBack).
+static uint32_t rejoinMs = 2000;
+static uint32_t linkBackAt = 0;
+static std::function<void()> onReconnect;   // what a reconnect repairs, per scenario
+static void wifiTask() {
+  if (PatternflowWifi::reconnectPending && simMs - PatternflowWifi::reconnectAskedAt >= 500) {
+    PatternflowWifi::reconnectPending = false;
+    WiFi.up = false;
+    linkBackAt = simMs + rejoinMs;
+    if (onReconnect) onReconnect();
+  }
+  if (!WiFi.up && linkBackAt && simMs >= linkBackAt) {
+    linkBackAt = 0;
+    WiFi.up = true;
+    PatternflowMidiRtp::networkBack();
+  }
+}
+
+static const int pattern = 3;   // what the panel shows, all day
+static void tick() {
+  ++simMs;
+  wifiTask();
+  PatternflowMidiRtp::handle();
+  flowLocal.service();
+  if (simMs % 16 == 0) {   // the frame: what the pattern shows goes out, and again to a host that arrived
+    InputFrame frame;
+    frame.now = simMs;
+    PatternflowMidi::observeFrame(frame, pattern);
+  }
+  // Never two of the panel's own participants with FlowLocal - an
+  // invitation beside another, or beside a session - and never a count of
+  // sessions the library does not list (a count stuck above zero is a panel
+  // that never invites again).
+  CHECK(initiatorsToHost() <= 1, "%u invitations/sessions with FlowLocal in the library", (unsigned)initiatorsToHost());
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+  CHECK(peers() <= (int)session.participants.size(), "peers %d with %u participants listed", peers(),
+        (unsigned)session.participants.size());
+#endif
+}
+static void run(uint32_t ms) { for (uint32_t i = 0; i < ms; ++i) tick(); }
+// Runs until the panel has a session with FlowLocal again (the library lists
+// it Connected and the panel counts it), at most `limitMs`; returns how long.
+static uint32_t untilJoined(uint32_t limitMs) {
+  const uint32_t from = simMs;
+  while (!(connectedToHost() && peers() == 1)) {
+    if (simMs - from >= limitMs) return UINT32_MAX;
+    tick();
+  }
+  return simMs - from;
+}
+static uint32_t untilSessionGone(uint32_t limitMs) {
+  const uint32_t from = simMs;
+  while (connectedToHost() || peers() > 0) {
+    if (simMs - from >= limitMs) return UINT32_MAX;
+    tick();
+  }
+  return simMs - from;
+}
+// The last time FlowLocal answered one of the panel's clock syncs.
+static uint32_t lastCk1At = 0;
+static void calm() {
+  air.lose = nullptr;
+  air.delay = nullptr;
+  onReconnect = nullptr;
+}
+// Between two scenarios: the session up for longer than every edition's 30 s
+// one-invitation window, so each scenario starts where the last invitation
+// no longer holds anything back.
+static void settle() { run(35000); }
+// FlowLocal's "reconnect panel", and how long until the panel has its session
+// again: the old one gone first (the BY takes a moment), then the new join.
+static uint32_t reconnectAndRejoin(uint32_t limitMs) {
+  const uint32_t from = simMs;
+  flowLocal.reconnectPanel();
+  if (untilSessionGone(limitMs) == UINT32_MAX || untilJoined(limitMs) == UINT32_MAX) return UINT32_MAX;
+  return simMs - from;
+}
+
+int main() {
+  // Boot: the link is up at 1 s (onNetwork -> begin()).
+  PatternflowMidi::loadSettings();
+  PatternflowMidiRtp::prepare();
+  simMs = 1000;
+  PatternflowMidiRtp::begin();
+  CHECK(PatternflowMidiRtp::workerTask == nullptr, "the test pumps from handle()");
+  uint32_t took = untilJoined(5000);
+  CHECK(took <= 1100, "joined %u ms after the link came up", (unsigned)took);
+  run(200);
+  CHECK(flowLocal.programChanges >= 1, "no Program Change reached FlowLocal after the join");
+  printf("boot: session %u ms after the link came up, Program Change sent\n", (unsigned)took);
+  settle();
+  CHECK(peers() == 1 && flowLocal.parts.size() == 1 && flowLocal.parts[0].joined, "steady");
+
+  // FlowLocal's answers to the panel's clock syncs, as they leave it: the
+  // dead-link scenario measures from the last one.
+  auto watchCk1 = [](const Datagram& d) {
+    if (d.srcIp == FL_IP && isAm(d, 'C', 'K') && d.bytes.size() > 8 && d.bytes[8] == 1) lastCk1At = simMs;
+    return false;
+  };
+
+  // ── 1. The monitor's "reconnect panel": FlowLocal ends the session. ────
+  {
+    const uint32_t pcs = flowLocal.programChanges;
+    took = reconnectAndRejoin(60000);
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(took <= 1200, "back %u ms after FlowLocal's BY (1 s after the end)", (unsigned)took);
+#else
+    CHECK(took <= 200, "back %u ms after FlowLocal's BY (the period had long passed)", (unsigned)took);
+#endif
+    run(200);
+    CHECK(flowLocal.programChanges > pcs, "the Program Change after the new join");
+    printf("reconnect panel: back in %u ms\n", (unsigned)took);
+    settle();
+  }
+
+  // ── 2. FlowLocal's one control OK is lost. ─────────────────────────────
+  {
+    bool lostOne = false;
+    air.lose = [&lostOne](const Datagram& d) {
+      if (!lostOne && d.srcIp == FL_IP && isAm(d, 'O', 'K') && d.srcPort == CTRL) { lostOne = true; return true; }
+      return false;
+    };
+    took = reconnectAndRejoin(60000);
+    CHECK(lostOne, "the OK was lost");
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    // 1 s, then 3 attempts ~1 s apart that FlowLocal ignores, the give-up,
+    // and 1 s later a new token: ~5 s.
+    CHECK(took <= 5500, "back %u ms after a lost OK", (unsigned)took);
+#else
+    CHECK(took >= 13000, "13 attempts before a new invitation: %u ms", (unsigned)took);
+#endif
+    printf("lost control OK: back in %u ms\n", (unsigned)took);
+    calm();
+    settle();
+  }
+
+  // ── 2b. The same, with FlowLocal flx-mon3, which answers a repeat of the
+  //        invitation again: the panel's next attempt, a second later, gets
+  //        the OK the first did not. ──────────────────────────────────────
+  {
+    flowLocal.reanswerRepeats = true;
+    bool lostOne = false;
+    air.lose = [&lostOne](const Datagram& d) {
+      if (!lostOne && d.srcIp == FL_IP && isAm(d, 'O', 'K') && d.srcPort == CTRL) { lostOne = true; return true; }
+      return false;
+    };
+    took = reconnectAndRejoin(60000);
+    CHECK(lostOne, "the OK was lost");
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(took <= 2200, "back %u ms after a lost OK, FlowLocal answering the repeat", (unsigned)took);
+#else
+    CHECK(took <= 1200, "back %u ms after a lost OK, FlowLocal answering the repeat", (unsigned)took);
+#endif
+    printf("lost control OK, FlowLocal flx-mon3: back in %u ms\n", (unsigned)took);
+    flowLocal.reanswerRepeats = false;
+    calm();
+    settle();
+  }
+
+  // ── 3. A NO for the control half (FlowLocal full). ────────────────────
+  {
+    flowLocal.refuseControl = 1;
+    const uint32_t nos = flowLocal.nos;
+    took = reconnectAndRejoin(60000);
+    CHECK(flowLocal.nos == nos + 1, "one NO");
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(took <= 2200, "back %u ms after a NO (the refusal reported, 1 s later a new invitation)", (unsigned)took);
+    CHECK(Serial.saw("refused by the host (NO)", simMs - took), "the refusal is logged");
+    CHECK(PatternflowMidiRtp::invitesRefused.load() >= 1, "and counted");
+#else
+    // The library's NO: erased without a word; the guard holds the host for
+    // its whole window (30 s) - the period (20 s) is shorter.
+    CHECK(took >= 29000, "a NO nothing reports: %u ms", (unsigned)took);
+#endif
+    printf("NO for the control half: back in %u ms\n", (unsigned)took);
+    settle();
+  }
+
+  // ── 4. A NO for the data half. ─────────────────────────────────────────
+  {
+    flowLocal.refuseData = 1;
+    took = reconnectAndRejoin(60000);
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(took <= 2200, "back %u ms after a data NO", (unsigned)took);
+#else
+    CHECK(took >= 29000, "a data NO nothing reports: %u ms", (unsigned)took);
+#endif
+    printf("NO for the data half: back in %u ms\n", (unsigned)took);
+    settle();
+  }
+
+  // ── 5. A BY reaches the invitation between its control OK and its join. ─
+  {
+    flowLocal.byeAfterControlOk = true;
+    took = reconnectAndRejoin(60000);
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(took <= 2300, "back %u ms after a BY before the join", (unsigned)took);
+#else
+    CHECK(took >= 29000, "a BY before the join schedules nothing: %u ms", (unsigned)took);
+#endif
+    printf("BY before the join: back in %u ms\n", (unsigned)took);
+    settle();
+  }
+
+  // ── 6. The monitor's reconnect, with FlowLocal's BY lost on the way. The
+  //       panel keeps its session until a heartbeat meets FlowLocal's BY for
+  //       an SSRC it no longer knows - none in FlowLocal's quiet second after
+  //       the reconnect, so a heartbeat inside it waits for its retry. Swept
+  //       across the heartbeat's phase: the reconnect 0, 0.5, ... 3.5 s later
+  //       each time. ────────────────────────────────────────────────────────
+  {
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    const int phases = 8;
+#else
+    const int phases = 1;
+#endif
+    uint32_t worstKnew = 0, worstBack = 0;
+    for (int phase = 0; phase < phases; ++phase) {
+      run(500u * (uint32_t)phase);
+      bool lostBye = false;
+      air.lose = [&lostBye](const Datagram& d) {
+        if (!lostBye && d.srcIp == FL_IP && isAm(d, 'B', 'Y')) { lostBye = true; return true; }
+        return false;
+      };
+      const uint32_t from = simMs;
+      flowLocal.reconnectPanel();
+      const uint32_t gone = untilSessionGone(120000);
+      took = untilJoined(60000);
+      CHECK(lostBye && took != UINT32_MAX, "the BY was lost, and the session came back");
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+      CHECK(gone <= EXHIBIT_HEARTBEAT_MS + 1100, "the panel learnt of it after %u ms", (unsigned)gone);
+      CHECK(simMs - from <= EXHIBIT_HEARTBEAT_MS + 2300, "back %u ms after a lost BY", (unsigned)(simMs - from));
+#else
+      CHECK(gone <= 10000 + 1100, "the panel learnt of it after %u ms", (unsigned)gone);
+#endif
+      worstKnew = std::max(worstKnew, gone);
+      worstBack = std::max(worstBack, simMs - from);
+      calm();
+      settle();
+    }
+    printf("reconnect with its BY lost: the panel knew after %u ms at worst, back after %u ms at worst (%d phase%s)\n",
+           (unsigned)worstKnew, (unsigned)worstBack, phases, phases == 1 ? "" : "s");
+  }
+
+  // ── 7. A dead link: nothing gets through either way, the Wi-Fi still up. ─
+  {
+    air.lose = [&watchCk1](const Datagram& d) { watchCk1(d); return false; };
+    run(9000);   // see a few clock syncs answered
+    const uint32_t deadFrom = simMs;
+    const uint32_t lastAnswer = lastCk1At;
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    const uint32_t heartbeat = EXHIBIT_HEARTBEAT_MS;
+#else
+    const uint32_t heartbeat = 10000;   // the library's
+#endif
+    CHECK(lastAnswer != 0 && deadFrom - lastAnswer <= heartbeat + 500, "a clock sync answered lately (last at %u)",
+          (unsigned)lastAnswer);
+    bool dead = true;
+    air.lose = [&dead](const Datagram&) { return dead; };
+    onReconnect = [&dead]() { dead = false; };   // the reconnect is what brings it back
+    const uint32_t heals = PatternflowWifi::reconnectsAsked;
+    const uint32_t gone = untilSessionGone(200000);
+    const uint32_t goneAfterAnswer = simMs - lastAnswer;
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    // HEARTBEAT + UNANSWERED x RETRY after the last answer, give or take a pass.
+    CHECK(goneAfterAnswer <= EXHIBIT_LET_GO_MS + 50 && goneAfterAnswer >= EXHIBIT_LET_GO_MS - 1100,
+          "session let go %u ms after FlowLocal's last answer", (unsigned)goneAfterAnswer);
+    CHECK(Serial.saw("stopped answering clock sync", simMs - 10), "logged");
+    CHECK(PatternflowMidiRtp::syncTimeouts.load() == 1, "counted");
+    // Invitations go unanswered; the self-heal reconnects the Wi-Fi a spell
+    // after the end, and the session is back soon after the link.
+    const uint32_t endedAt = simMs;
+    while (PatternflowWifi::reconnectsAsked == heals && simMs - endedAt < 120000) tick();
+    const uint32_t healAfter = simMs - endedAt;
+    CHECK(PatternflowWifi::reconnectsAsked == heals + 1, "a reconnect asked for");
+    CHECK(healAfter >= EXHIBIT_HEAL_MS && healAfter <= EXHIBIT_HEAL_MS + 100, "the heal %u ms after the end", (unsigned)healAfter);
+    took = untilJoined(60000);
+    CHECK(took <= 500 + rejoinMs + 1300, "back %u ms after the reconnect was asked for", (unsigned)took);
+    printf("dead link: let go %u ms after the last answer, Wi-Fi reconnect %u ms after that, back %u ms later "
+           "(%u ms from the link dying to a session)\n",
+           (unsigned)goneAfterAnswer, (unsigned)healAfter, (unsigned)took, (unsigned)(simMs - deadFrom));
+#else
+    // The library's own: six CK0s ten seconds apart after the next heartbeat.
+    CHECK(goneAfterAnswer >= 55000 && goneAfterAnswer <= 71000, "session let go %u ms after the last answer",
+          (unsigned)goneAfterAnswer);
+    CHECK(PatternflowWifi::reconnectsAsked == heals, "no self-heal in this build");
+    dead = false;
+    took = untilJoined(60000);
+    CHECK(took != UINT32_MAX, "back when the link is");
+    printf("dead link: let go %u ms after the last answer (library timing)\n", (unsigned)goneAfterAnswer);
+#endif
+    (void)gone;
+    calm();
+    settle();
+  }
+
+  // ── 8. A NO for a session already up. The OK for the panel's first data
+  //       invitation is slow; FlowLocal's reconnect runs before the second
+  //       arrives (its BY lost), so that one gets a NO - which comes back
+  //       after the slow OK has made the session. FlowLocal's quiet second
+  //       after the reconnect keeps its BY for the panel's Program Change
+  //       from ending the session first. ─────────────────────────────────
+  {
+    bool slowOk = false, slowNo = false, dropped = false, loseBye = false;
+    air.delay = [&](const Datagram& d) -> uint32_t {
+      if (d.srcIp == FL_IP && d.srcPort == DATA && isAm(d, 'O', 'K') && !slowOk) { slowOk = true; return 1100; }
+      if (d.srcIp == FL_IP && d.srcPort == DATA && isAm(d, 'N', 'O') && !slowNo) { slowNo = true; return 500; }
+      return 2;
+    };
+    air.lose = [&](const Datagram& d) {
+      if (slowOk && !dropped && d.srcIp == PANEL_IP && d.srcPort == DATA && isAm(d, 'I', 'N')) {
+        dropped = true;
+        loseBye = true;
+        flowLocal.reconnectPanel();   // sends its BY through here: lost, below
+      }
+      if (loseBye && d.srcIp == FL_IP && isAm(d, 'B', 'Y')) { loseBye = false; return true; }
+      return false;
+    };
+    const uint32_t from = simMs, strangerByes = flowLocal.strangerByes;
+    took = reconnectAndRejoin(10000);   // joined on the slow OK...
+    CHECK(took != UINT32_MAX && slowOk, "joined on the slow OK");
+    const uint32_t gone = untilSessionGone(10000);   // ...and ended by the NO
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    CHECK(slowNo && gone != UINT32_MAX, "the NO ended the session that was up");
+    CHECK(Serial.saw("rtp session left", simMs - 5) && flowLocal.strangerByes == strangerByes,
+          "ended by the NO, not by a BY for a stranger");
+    took = untilJoined(10000);
+    CHECK(took <= 1300, "back %u ms after the NO", (unsigned)took);
+    printf("NO for a session that was up: ended, back %u ms later (%u ms in all)\n", (unsigned)took,
+           (unsigned)(simMs - from));
+#else
+    // The library erases it without a word: the panel still counts the
+    // session it no longer has, and never invites again.
+    CHECK(slowNo && gone == UINT32_MAX && peers() == 1 && session.participants.size() == 0 &&
+              flowLocal.strangerByes == strangerByes,
+          "every edition: a NO for a live session leaves peers at %d with %u listed", peers(),
+          (unsigned)session.participants.size());
+    printf("NO for a session that was up: every edition keeps counting it, and never invites again\n");
+#endif
+    calm();
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+    settle();
+#endif
+    (void)from;
+  }
+
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+  // ── 9. FlowLocal refuses every invitation for 10 s (both slots taken):
+  //       one NO a second, no self-heal - the link works - and the session
+  //       the moment it takes one. ─────────────────────────────────────────
+  {
+    const uint32_t heals = PatternflowWifi::reconnectsAsked, nos = flowLocal.nos;
+    flowLocal.refuseControlUntil = simMs + 10000;
+    took = reconnectAndRejoin(60000);
+    CHECK(took >= 10000 && took <= 11200, "back %u ms after 10 s of NOs", (unsigned)took);
+    CHECK(flowLocal.nos - nos >= 8 && flowLocal.nos - nos <= 11, "%u NOs", (unsigned)(flowLocal.nos - nos));
+    CHECK(PatternflowWifi::reconnectsAsked == heals, "no reconnect for a host that answers");
+    printf("10 s of NOs: %u refusals, back %u ms after the first\n", (unsigned)(flowLocal.nos - nos), (unsigned)took);
+    settle();
+  }
+
+  // ── 10. Hours on a lossy link. Every packet either way lost at random,
+  //        FlowLocal's reconnect now and then, the Wi-Fi dropping now and
+  //        then. The checks in tick() hold throughout; a live session is
+  //        dropped only by a run of lost exchanges, and never by FlowLocal's
+  //        25 s timeout; and after every end the session is back in time. ──
+  for (const uint32_t percent : {10u, 20u, 30u}) {
+    air.lose = [percent](const Datagram&) { return nextRandom() % 100 < percent; };
+    const uint32_t timeouts = flowLocal.timeouts, syncEnds = PatternflowMidiRtp::syncTimeouts.load();
+    uint32_t ends = 0, worstGap = 0, gaps = 0;
+    uint64_t gapSum = 0;
+    const uint32_t hours = percent == 10 ? 3 : 1;
+    const uint32_t stop = simMs + hours * 3600000u;
+    uint32_t nextPoke = simMs + 120000;
+    bool wasUp = connectedToHost();
+    uint32_t downSince = simMs;
+    while (simMs < stop) {
+      tick();
+      const bool up = connectedToHost() && peers() == 1;
+      if (wasUp && !up) { ++ends; downSince = simMs; }
+      if (!wasUp && up) { const uint32_t gap = simMs - downSince; worstGap = std::max(worstGap, gap); gapSum += gap; ++gaps; }
+      wasUp = up;
+      if (simMs >= nextPoke) {
+        nextPoke = simMs + 60000 + nextRandom() % 180000;
+        if (nextRandom() % 2) flowLocal.reconnectPanel();
+        else { WiFi.up = false; linkBackAt = simMs + 1000 + nextRandom() % 4000; }
+      }
+    }
+    const uint32_t lossEnds = PatternflowMidiRtp::syncTimeouts.load() - syncEnds;
+    printf("%u%% loss for %u h: %u sessions ended (%u of them by %u clock syncs in a row lost), FlowLocal timed out %u; "
+           "back after %.1f s on average, %.1f s at worst\n",
+           (unsigned)percent, (unsigned)hours, (unsigned)ends, (unsigned)lossEnds, (unsigned)EXHIBIT_UNANSWERED,
+           (unsigned)(flowLocal.timeouts - timeouts), gaps ? gapSum / 1000.0 / gaps : 0.0, worstGap / 1000.0);
+    CHECK(flowLocal.timeouts == timeouts || percent >= 30, "FlowLocal timed a live session out at %u%% loss", (unsigned)percent);
+    if (percent == 10) CHECK(lossEnds == 0, "a session dropped for lost clock syncs at 10%% loss");
+    CHECK(worstGap <= (percent == 30 ? 90000u : 45000u), "%.1f s without a session", worstGap / 1000.0);
+    calm();
+    if (!WiFi.up) { run(6000); }
+    took = untilJoined(60000);
+    CHECK(took != UINT32_MAX, "back after the lossy hours");
+    settle();
+  }
+#endif
+
+  printf("PASS: midi_rtp_test (%s), %.1f simulated minutes, %" PRIu64 " datagrams, %" PRIu64 " lost\n",
+#if defined(MIDI_RTP_TEST_EXHIBIT)
+         "exhibit",
+#else
+         "every edition",
+#endif
+         simMs / 60000.0, air.sent, air.lost);
+  return failures ? 1 : 0;
+}
