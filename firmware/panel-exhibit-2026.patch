+// ── The air ─────────────────────────────────────────────────────────────
+struct Datagram {
+  uint32_t srcIp; uint16_t srcPort; uint32_t dstIp; uint16_t dstPort;
+  std::vector<uint8_t> bytes;
+  uint32_t at = 0;
+};
+struct Air {
+  std::deque<Datagram> flying;
+  std::function<bool(const Datagram&)> lose;       // true = lost on the way
+  std::function<uint32_t(const Datagram&)> delay;  // ms on the way; 2 when not set
+  uint64_t sent = 0, lost = 0;
+  void send(Datagram d) {
+    ++sent;
+    if (!WiFi.up && (d.srcIp == PANEL_IP || d.dstIp == PANEL_IP)) { ++lost; return; }
+    if (lose && lose(d)) { ++lost; return; }
+    d.at = simMs + (delay ? delay(d) : 2);
+    flying.push_back(std::move(d));
+  }
+  // The earliest datagram that has arrived at ip:port, in arrival order.
+  bool take(uint32_t ip, uint16_t port, Datagram& out) {
+    auto best = flying.end();
+    for (auto it = flying.begin(); it != flying.end(); ++it) {
+      if (it->dstIp != ip || it->dstPort != port || it->at > simMs) continue;
+      if (best == flying.end() || it->at < best->at) best = it;
+    }
+    if (best == flying.end()) return false;
+    out = std::move(*best);
+    flying.erase(best);
+    if (!WiFi.up && out.dstIp == PANEL_IP) { ++lost; return false; }
+    return true;
+  }
+} air;
