+// ── FlowLocal ───────────────────────────────────────────────────────────
+static void put32(std::vector<uint8_t>& b, uint32_t v) { for (int s = 24; s >= 0; s -= 8) b.push_back((uint8_t)(v >> s)); }
+static void put64(std::vector<uint8_t>& b, uint64_t v) { put32(b, (uint32_t)(v >> 32)); put32(b, (uint32_t)v); }
+static uint32_t get32(const std::vector<uint8_t>& b, size_t i) {
+  return i + 4 > b.size() ? 0 : (uint32_t)b[i] << 24 | (uint32_t)b[i + 1] << 16 | (uint32_t)b[i + 2] << 8 | b[i + 3];
+}
+static uint64_t get64(const std::vector<uint8_t>& b, size_t i) { return (uint64_t)get32(b, i) << 32 | get32(b, i + 4); }
+static std::vector<uint8_t> amInvitation(char c0, char c1, uint32_t token, uint32_t ssrc, const char* name) {
+  std::vector<uint8_t> b = {0xFF, 0xFF, (uint8_t)c0, (uint8_t)c1, 0, 0, 0, 2};
+  put32(b, token); put32(b, ssrc);
+  for (const char* p = name; *p; ++p) b.push_back((uint8_t)*p);
+  b.push_back(0);
+  return b;
+}
+static std::vector<uint8_t> amBye(uint32_t ssrc) {
+  std::vector<uint8_t> b = {0xFF, 0xFF, 'B', 'Y', 0, 0, 0, 2};
+  put32(b, 0); put32(b, ssrc);
+  return b;
+}
+static std::vector<uint8_t> amSync(uint32_t ssrc, uint8_t count, uint64_t t0, uint64_t t1, uint64_t t2) {
+  std::vector<uint8_t> b = {0xFF, 0xFF, 'C', 'K'};
+  put32(b, ssrc);
+  b.push_back(count); b.push_back(0); b.push_back(0); b.push_back(0);
+  put64(b, t0); put64(b, t1); put64(b, t2);
+  return b;
+}
+static bool isAm(const Datagram& d, char c0, char c1) {
+  return d.bytes.size() >= 4 && d.bytes[0] == 0xFF && d.bytes[1] == 0xFF && d.bytes[2] == (uint8_t)c0 && d.bytes[3] == (uint8_t)c1;
+}
+
+struct FlowLocalModel {
+  struct Part { uint32_t ssrc, token, ip; uint16_t ctrlPort, dataPort; bool joined; uint32_t heard; };
+  std::vector<Part> parts;
+  const uint32_t ssrc = 0x2468ACE0u;
+  uint32_t timeoutMs = 25000;          // silent sessions, FlowLocal's CK_MaxTimeOut to be
+  int refuseControl = 0, refuseData = 0;   // the next N invitations of that half get a NO
+  uint32_t refuseControlUntil = 0;     // ...or every control invitation until then
+  bool byeAfterControlOk = false;      // one BY right behind the next control OK
+  bool reanswerRepeats = false;        // flx-mon3: a repeated invitation gets its OK again
+  uint32_t lastStranger = 0, lastStrangerBye = 0, quietSince = 0;
+  bool quiet = false;
+  // What happened, for the checks.
+  uint32_t nos = 0, timeouts = 0, strangerByes = 0, programChanges = 0, lastProgramAt = 0, midiMessages = 0;
+
+  Part* find(uint32_t s) { for (auto& p : parts) if (p.ssrc == s) return &p; return nullptr; }
+  void send(uint16_t fromPort, uint32_t toIp, uint16_t toPort, std::vector<uint8_t> bytes) {
+    air.send(Datagram{FL_IP, fromPort, toIp, toPort, std::move(bytes), 0});
+  }
+  bool shouldByeStranger(uint32_t stranger) {
+    if (quiet) {
+      if (simMs - quietSince < 1000) return false;
+      quiet = false;
+    }
+    if (stranger == lastStranger && lastStrangerBye != 0 && simMs - lastStrangerBye < 1000) return false;
+    lastStranger = stranger;
+    lastStrangerBye = simMs | 1;
+    ++strangerByes;
+    return true;
+  }
+  void control(const Datagram& d) {
+    if (isAm(d, 'I', 'N')) {
+      const uint32_t token = get32(d.bytes, 8), s = get32(d.bytes, 12);
+      for (size_t i = 0; i < parts.size();) {
+        bool replaced = false;
+        if (parts[i].ssrc == s) {
+          if (parts[i].token == token) {
+            // A repeat of one answered. FlowLocal as flashed on 2026-09-25
+            // ignores it; flx-mon3 answers it again until the data half has
+            // begun (no data invitation seen, so the panel cannot have the OK).
+            if (reanswerRepeats && parts[i].dataPort == 0)
+              send(CTRL, d.srcIp, d.srcPort, amInvitation('O', 'K', token, ssrc, "FlowLocal"));
+            return;
+          }
+          replaced = true;                         // the panel started over
+        } else if (parts[i].ip == d.srcIp && parts[i].ctrlPort == d.srcPort) {
+          replaced = true;                         // the panel rebooted
+        }
+        if (replaced) parts.erase(parts.begin() + (long)i); else ++i;
+      }
+      if (parts.size() >= 2 || refuseControl > 0 || simMs < refuseControlUntil) {
+        if (refuseControl > 0) --refuseControl;
+        ++nos;
+        send(CTRL, d.srcIp, d.srcPort, amInvitation('N', 'O', token, ssrc, "FlowLocal"));
+        return;
+      }
+      parts.push_back({s, token, d.srcIp, d.srcPort, 0, false, simMs});
+      send(CTRL, d.srcIp, d.srcPort, amInvitation('O', 'K', token, ssrc, "FlowLocal"));
+      if (byeAfterControlOk) { byeAfterControlOk = false; send(CTRL, d.srcIp, d.srcPort, amBye(ssrc)); }
+    } else if (isAm(d, 'B', 'Y')) {
+      const uint32_t s = get32(d.bytes, 12);
+      for (size_t i = 0; i < parts.size(); ++i)
+        if (parts[i].ssrc == s) { parts.erase(parts.begin() + (long)i); break; }
+    }
+  }
+  void data(const Datagram& d) {
+    if (isAm(d, 'I', 'N')) {
+      const uint32_t token = get32(d.bytes, 8), s = get32(d.bytes, 12);
+      Part* p = find(s);
+      if (!p || refuseData > 0) {
+        if (p && refuseData > 0) --refuseData;
+        ++nos;
+        send(DATA, d.srcIp, d.srcPort, amInvitation('N', 'O', token, ssrc, "FlowLocal"));
+        return;
+      }
+      p->dataPort = d.srcPort;
+      p->joined = true;
+      send(DATA, d.srcIp, d.srcPort, amInvitation('O', 'K', token, ssrc, "FlowLocal"));
+    } else if (isAm(d, 'C', 'K')) {
+      const uint32_t s = get32(d.bytes, 4);
+      const uint8_t count = d.bytes.size() > 8 ? d.bytes[8] : 0;
+      Part* p = find(s);
+      if (!p) {
+        if (d.srcPort > 1 && shouldByeStranger(s)) send(CTRL, d.srcIp, (uint16_t)(d.srcPort - 1), amBye(ssrc));
+        return;
+      }
+      if (count == 0) send(DATA, p->ip, p->dataPort, amSync(ssrc, 1, get64(d.bytes, 12), simMs * 10ull, 0));
+      p->heard = simMs;
+    } else if (d.bytes.size() >= 13 && (d.bytes[0] & 0xC0) == 0x80) {   // RTP MIDI
+      const uint32_t s = get32(d.bytes, 8);
+      if (!find(s)) {
+        if (d.srcPort > 1 && shouldByeStranger(s)) send(CTRL, d.srcIp, (uint16_t)(d.srcPort - 1), amBye(ssrc));
+        return;
+      }
+      for (size_t i = 13; i < d.bytes.size(); ++i) {
+        const uint8_t b = d.bytes[i];
+        if ((b & 0x80) && b < 0xF0) ++midiMessages;
+        if ((b & 0xF0) == 0xC0) { ++programChanges; lastProgramAt = simMs; }
+      }
+    }
+  }
+  void service() {
+    Datagram d;
+    while (air.take(FL_IP, CTRL, d)) control(d);
+    while (air.take(FL_IP, DATA, d)) data(d);
+    for (size_t i = 0; i < parts.size();) {
+      if (simMs - parts[i].heard > timeoutMs) {
+        send(CTRL, parts[i].ip, parts[i].ctrlPort, amBye(ssrc));
+        parts.erase(parts.begin() + (long)i);
+        ++timeouts;
+      } else {
+        ++i;
+      }
+    }
+  }
+  // The laptop monitor's "reconnect panel": a BY to every session, each
+  // dropped from the list, and no BY of its own for a second.
+  void reconnectPanel() {
+    for (auto& p : parts) send(CTRL, p.ip, p.ctrlPort, amBye(ssrc));
+    parts.clear();
+    quiet = true;
+    quietSince = simMs;
+  }
+} flowLocal;
