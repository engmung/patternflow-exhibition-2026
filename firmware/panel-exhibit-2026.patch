-template<class T, class V> void __atomic_store_n(T* p, V v, int) { std::atomic_ref<T>(*p).store(static_cast<T>(v)); }
+static std::mutex atomicShim;
+template<class T, class V> T __atomic_fetch_add(T* p, V v, int) { std::lock_guard<std::mutex> g(atomicShim); T old = *p; *p = static_cast<T>(old + static_cast<T>(v)); return old; }
+template<class T, class V> T __atomic_add_fetch(T* p, V v, int) { std::lock_guard<std::mutex> g(atomicShim); *p = static_cast<T>(*p + static_cast<T>(v)); return *p; }
