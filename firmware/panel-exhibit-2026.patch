+// The panel's two sockets.
+class WiFiUDP {
+  uint16_t local = 0;
+  Datagram in{}, out{};
+  size_t pos = 0;
+  bool reading = false, building = false;
+public:
+  uint8_t begin(uint16_t port) { local = port; return 1; }
+  void stop() { local = 0; }
+  int beginPacket(IPAddress ip, uint16_t port) {
+    out = Datagram{PANEL_IP, local, (uint32_t)ip, port, {}, 0};
+    building = true;
+    return 1;
+  }
+  size_t write(const uint8_t* b, size_t n) { if (building) out.bytes.insert(out.bytes.end(), b, b + n); return n; }
+  size_t write(uint8_t b) { return write(&b, 1); }
+  int endPacket() { if (!building) return 0; building = false; air.send(out); return 1; }
+  void flush() {}
+  int parsePacket() { pos = 0; reading = air.take(PANEL_IP, local, in); return reading ? (int)in.bytes.size() : 0; }
+  int available() { return reading ? (int)(in.bytes.size() - pos) : 0; }
+  int read() { return (!reading || pos >= in.bytes.size()) ? -1 : in.bytes[pos++]; }
+  int read(uint8_t* b, size_t n) {
+    if (!reading) return 0;
+    const size_t k = std::min(n, in.bytes.size() - pos);
+    memcpy(b, in.bytes.data() + pos, k);
+    pos += k;
+    return (int)k;
+  }
+  IPAddress remoteIP() { return IPAddress(in.srcIp); }
+  uint16_t remotePort() { return in.srcPort; }
+};
