new file mode 100644
index 0000000..2f2bb00
--- /dev/null
+++ b/firmware/toolchain/tests/midi_rtp_test.cpp
@@ -0,0 +1,893 @@
+// The RTP-MIDI transport on the real library: features/midi/core_midi_rtp.h
+// over AppleMIDI 3.5.0 and the MIDI Library as PlatformIO fetched them, with
+// Arduino, Wi-Fi, UDP, FreeRTOS and NVS stood in for below, against a model of
+// FlowLocal - the exhibit's session listener - on a simulated network that
+// loses, delays or answers what each scenario says. check_midi.py builds it
+// twice: as the exhibit bundle sets it (MIDI_RTP_TEST_EXHIBIT) and as every
+// edition ships it (MIDI_RTP_TEST_EDITIONS, with only a host to invite).
+//
+// The panel is not modelled. handle() runs the real pump() every millisecond
+// (no worker task: xTaskCreatePinnedToCore() fails here, which is
+// core_midi_rtp.h's own frame-polling fallback), the library parses and
+// answers real packets, and its participant list is read directly after
+// every millisecond - that list is what "two invitations open to one host"
+// is about. FlowLocal is modelled on flowlocal/src/fl_midi_bridge.h (and the
+// library's listener code it keeps): it only listens; it ignores a repeat of
+// an invitation it has answered (same SSRC and token) - or, as flx-mon3 does,
+// answers it again until the data half has begun - and replaces a session
+// when the same SSRC comes with a new token, or a new SSRC from the same
+// address; refuses (NO) when its two slots are full; answers a data
+// invitation for an SSRC it does not hold with a NO; answers CK0 with CK1;
+// answers a heartbeat or MIDI from an SSRC it does not know with a BY (one a
+// second at most, none for 1 s after "reconnect panel"); ends a session it
+// has heard no clock sync from for 25 s (flx-mon3's timeout); and "reconnect
+// panel" ends every session with a BY.
+//
+// One timeline, as a panel lives through a day: it boots, joins, and then
+// meets one failure after another - each phase starting from a session that
+// has been up for a while - with the time each one costs measured and bounded.
+#include <algorithm>
+#include <atomic>
+#include <cassert>
+#include <cinttypes>
+#include <cmath>
+#include <cstdarg>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <inttypes.h>
+#include <stdint.h>
+#include <string.h>
+#include <string>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#if defined(MIDI_RTP_TEST_EXHIBIT) == defined(MIDI_RTP_TEST_EDITIONS)
+#error "build with MIDI_RTP_TEST_EXHIBIT or MIDI_RTP_TEST_EDITIONS (check_midi.py does)"
+#endif
+
+// ── Arduino ─────────────────────────────────────────────────────────────
+typedef uint8_t byte;
+static uint32_t simMs = 0;
+static uint32_t millis() { return simMs; }
+static uint32_t micros() { return simMs * 1000u; }
+static uint32_t rngState = 0x2545F491u;
