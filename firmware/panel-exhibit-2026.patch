index 0000000..783c592
--- /dev/null
+++ b/firmware/bundles/exhibit/features_local.h
@@ -0,0 +1,95 @@
+// ═══════════════════════════════════════════════════════════
+// Patternflow Exhibit — which features this firmware carries
+//
+// A private build for one gallery panel (2026-10): visitors turn the knobs,
+// the sound comes from Ableton Live on a laptop under the desk.
+//
+//   exhibit   K4 switches among six compiled-in artist patterns, the
+//             long-press screens are shut, an idle panel goes back to its
+//             default pattern, a caption names the artist after a switch.
+//   midi      the knobs and the pattern out to the laptop over RTP-MIDI:
+//             K1-K3 as CC 24-26 - the exhibit's knob positions themselves,
+//             the ones the patterns draw with (PF_MIDI_OUT_LANE_ABSOLUTE in
+//             overrides.h) - the pattern as Program Change. The panel
+//             invites the venue's FlowLocal box (overrides.h), which carries
+//             the session to the laptop as a USB MIDI device. The same
+//             session carries the panel's own footfall notes (below).
+//
+// Not on the shelf and not in build.sh's composition list: nobody else has
+// this panel, and CI has no reason to keep compiling it.
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+
+// midi first, and it has to be: the exhibit is included below with a sink
+// already named, and the name has to exist by then. The order of the includes
+// is not the order of the list - that is PF_FEATURE_LIST at the bottom, and
+// the exhibit is still first there.
+#include "midi/feature_midi.h"
+
+// ── The footfall notes ──────────────────────────────────────────────────
+//
+// The exhibit's patterns mark moments - the gecko's foot landing - and the
+// exhibit turns each into a MIDI note the instant the frame that drew it is
+// on the panel (features/exhibit/exhibit_pulse.h). It does not know how to
+// send one: features do not know each other (check_boundaries.py, R4), and
+// this file is the only one that knows this image carries both. So the wire
+// is named here, and it is the one every other message already uses -
+// PatternflowMidi::emit, the same call behind the knob CCs, the button notes
+// and the Program Change. The notes therefore ride the same RTP session to
+// FlowLocal, count in /api/midi's tx, and arrive in Live through the same USB
+// port as everything else; there is no second connection to set up and
+// nothing extra to go wrong at the venue.
+//
+// emit() does not look at the /midi page's on/off switch - observeFrame does
+// that for the messages it sends - so the check is here, and turning MIDI off
+// silences the footsteps along with the knobs.
+//
+// The notes, the channel (10, the drum channel) and the velocity are the
+// exhibit's own: features/exhibit/exhibit_config.h, PF_EXHIBIT_PULSE_*.
+// A note-off always goes out, even with MIDI switched off: the switch can move
+// while a footfall note is down (about 8 % of the time at the centre speed),
+// and the pulse scheduler frees the slot as it sends the release. Swallowing
+// that one message would leave the note down in Live until the same note is
+// struck again - on a sustaining instrument, possibly never. The midi feature
+// makes the same exception for the button notes (core_midi.h keeps lastHeld
+// across the switch so the release still fires).
+static void pfExhibitPulseToMidi(uint8_t status, uint8_t d1, uint8_t d2) {
+  const bool noteOff = (status & 0xF0) == 0x80;
+  if (!PatternflowMidi::runtimeEnabled && !noteOff) return;
+  PatternflowMidi::emit(status, d1, d2);
+}
+#define PF_EXHIBIT_PULSE_SINK pfExhibitPulseToMidi
+
+#include "exhibit/feature_exhibit.h"
+
+// Order is dispatch order, and here it decides three things.
+//
+//  1. fillInput. The frame reaches the features holding the physical encoders
+//     and buttons and nothing else (readInputFrame). The exhibit goes first so
+//     that what it reads is exactly that: its K4 accumulator counts a hand's
+//     detents, and its idle clock is reset by hands only. It then removes K4
+//     from the frame before any other feature runs - midi's fillInput only adds
+//     remote input on top, and midi's observeFrame, later in the frame, sees
+//     K4 at zero and sends no CC 27 and no note 63. The same goes for K1-K3's
+//     detents, which the exhibit turns into its knob positions and hands on
+//     as lanes: midi reports the lanes, never the detents a second time.
+//
+//  2. takePattern. The sketch asks the features in this order and the FIRST
+//     that has a request wins the frame; the next one is served on the frame
+//     after (pf_features.h - requests are edges, so none is lost). A visitor's
+//     K4 turn, the idle return and the boot default are therefore performed
+//     before an inbound MIDI Program Change arriving in the same frame.
+//     Neither feature CLAIMS the pattern, so both count as a person's choice
+//     and the web console's picker is never locked out.
+//
+//  3. Everything else is independent: the exhibit has no observeFrame, midi
+//     has no drawOverlay, and /api/status simply lists "exhibit" before
+//     "midi". The footfall notes above are not an exception: they leave from
+//     the exhibit's drawOverlay, which the sketch calls after midi's
+//     observeFrame, so a frame that both switches pattern and lands a foot
+//     sends the Program Change first and the note after it.
+#define PF_FEATURE_LIST              \
+  &PFFeatureExhibit::descriptor,     \
+      &PFFeatureMidi::descriptor
diff --git a/firmware/bundles/exhibit/overrides.h b/firmware/bundles/exhibit/overrides.h
new file mode 100644
index 0000000..020f960
--- /dev/null
+++ b/firmware/bundles/exhibit/overrides.h
@@ -0,0 +1,164 @@
+// ═══════════════════════════════════════════════════════════
+// Patternflow Exhibit — what this firmware calls itself, and what it sets
+//
+// Included from config.h before any default, so anything `#ifndef`-guarded
+// anywhere in the tree can be set here. The exhibit feature's own tunables
+// (menu lock, detents per step, idle return, caption) keep their defaults
+// from features/exhibit/exhibit_config.h unless set below.
+//
+// Wi-Fi credentials are NOT here: they are per device, in the gitignored
+// firmware/patternflow/patternflow_secrets.h. This build joins that network
+// and no other (PF_WIFI_BUILTIN_ONLY below).
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+
+// Reported in /api/status as `variant` / `variantVersion` and worn as a badge
+// in the console header. Its own version line, independent of the core's.
+#define PF_VARIANT          "exhibit"
+#define PF_VARIANT_VERSION  "v0.1.0"
+
+// ── The six artist patterns, compiled in ────────────────────────────────
+// The include is taken by features/feature_presets.h right before the
+// registry expands the list, which is why it is named here and not included
+// from features_local.h (features/feature_presets.h explains the build
+// failure an include anywhere else causes). The rows land after Origin:
+// pattern index 1..6, Program Change 1..6.
+#define PF_FEATURE_PRESET_INCLUDE "exhibit/exhibit_presets.h"
+#define PF_FEATURE_PRESETS        PF_EXHIBIT_PRESET_ENTRIES
+
+// No caption: a switch shows only the picture, never the artist's name
+// (the romanised names were not confirmed with the artists). A panel that
+// stored a choice on /api/exhibit keeps it; ?caption=default forgets it.
+#define PF_EXHIBIT_CAPTION 0
+
+// ── Wi-Fi ───────────────────────────────────────────────────────────────
+// The panel joins PF_WIFI_SSID / PF_WIFI_PASS from patternflow_secrets.h -
+// FlowLocal's hotspot - and never a network saved on it. Without this, the
+// core's rule is that ANY saved network switches the compiled one off
+// entirely, and a panel that once knew a home network sat inviting a
+// FlowLocal it had never joined (2026-09-25). Saved entries are still listed
+// on /wifi, marked not used, and can be forgotten; /api/wifi refuses to add
+// or choose one, and Improv answers "unable to connect". net_config.h.
+// Without patternflow_secrets.h this build stops at compile time (core_wifi.h)
+// rather than make a panel that only ever tries the placeholder SSID.
+#define PF_WIFI_BUILTIN_ONLY 1
+
+// Full transmit power instead of the core's 13 dBm. That cap is headroom
+// under the EU 20 dBm EIRP limit for a conformance test (4ece4cc), not a
+// power or LED-noise measure - the display's EMC note calls Wi-Fi power
+// almost irrelevant there - and it was measured on a bench, never with the
+// antenna behind the panel's metal frame. Here the panel's own transmitter
+// carries every invitation and every MIDI byte to FlowLocal, on a 2.4 GHz
+// channel shared with the venue's access points and received next to a
+// laptop's USB ports. 19.5 dBm is the radio's own default; /api/status
+// txDbm shows what the radio actually runs at.
+//
+// PF_WIFI_RETRY_INTERVAL_MS stays at the core's 5 s: the Arduino core already
+// re-joins at once on every drop and failed scan (auto-reconnect), and this
+// timer's retry disconnects first, so a shorter one would cut short a join
+// that is half done rather than start one sooner.
+#define PF_WIFI_TX_POWER WIFI_POWER_19_5dBm
+
+// ── MIDI ────────────────────────────────────────────────────────────────
+// FlowLocal's hotspot address. The panel invites it on its own whenever no
+// session is up (the timings below), so nobody has to connect anything at
+// the venue.
+#define PF_MIDI_DEFAULT_HOST "192.168.66.1"
+
+// ...and nothing on /midi can change that, or switch MIDI off: a host or an
+// "off" saved in NVS (pf_midi) is not read, and /api/midi refuses both with
+// a message - "Use this computer" and "Clear" on a phone used to break the
+// show. The page shows the host and the switch as fixed. core_midi.h.
+#define PF_MIDI_SESSION_LOCKED 1
+
+// The first invitation 1 s after the Wi-Fi is up instead of 20 s: the 20 s
+// head start is for rtpMIDI on a computer re-joining a remembered panel by
+// itself, and FlowLocal only ever listens. core_midi_rtp.h.
+#define PF_MIDI_FIRST_INVITE_DELAY_MS 1000
+
+// When the Wi-Fi comes back after a drop - FlowLocal rebooting takes its
+// hotspot down with it - the session the panel still lists is ended at once
+// and FlowLocal invited again 1 s later, instead of the panel waiting for the
+// library's clock sync to notice (a BY from FlowLocal answers the next CK0,
+// up to 10 s after the link is back; ~70 s if nothing answered at all).
+// core_midi_rtp.h.
+#define PF_MIDI_REINVITE_ON_REJOIN 1
+
+// Each invitation is sent 3 times, a second apart, instead of the library's
+// 13, then given up and a new one sent 1 s later (below). FlowLocal answers
+// in milliseconds but ignores a repeat of an invitation it has already
+// answered, so when that one answer is lost on the air only a new invitation
+// helps. One lost answer cost 20 s before (13 attempts, then the 20 s
+// re-invite period); ~4 s now. core_midi_rtp.h.
+#define PF_MIDI_INVITE_ATTEMPTS 3
+
+// Invited again 1 s after an invitation is given up or the session ends -
+// FlowLocal ending it included, which is what the laptop monitor's reconnect
+// does - instead of on the 20 s re-invite period. core_midi_rtp.h.
+#define PF_MIDI_REINVITE_AFTER_END_MS 1000
+
+// ...and 1 s after FlowLocal turns an invitation down: its NO, which the
+// library dropped without a word to the panel, and a BY that reaches an
+// invitation before it has joined, whose end scheduled nothing. Both left the
+// next invitation to the 20 s re-invite period: the sessions that took
+// 20-24 s after the panel joined the hotspot, and 23 s after the monitor's
+// "reconnect panel", on the lossy channel of 2026-09-27. A NO also tells the
+// self-heal below that the link works. core_midi_rtp.h.
+#define PF_MIDI_REINVITE_ON_REJECTION 1
+
+// Whatever still falls to the re-invite period waits 3 s for it, not 20 s.
+// The one-invitation guard (10 s with 3 attempts) still comes first, so this
+// never sends an invitation while the last one may be open. core_midi_rtp.h.
+#define PF_MIDI_REINVITE_MS 3000
+
+// A session FlowLocal no longer answers is let go 12 s after its last answer
+// instead of ~70 s, and FlowLocal invited again 1 s later: a clock sync every
+// 4 s (the library: 10 s), one that goes unanswered sent again every second
+// (10 s), and the session ended when 8 in a row go unanswered (6) - 4 + 8 x 1.
+// Until then it counts as up, so nothing is invited: on 2026-09-27 FlowLocal
+// heard nothing from a "connected" panel for over 30 s. Any answer stops the
+// count, so a lossy link has to lose 8 exchanges in a row: at 10 % loss each
+// way about once a month, at 20 % every few hours. The 4 s heartbeat also
+// keeps the session well inside the 25 s FlowLocal gives a silent one.
+// core_midi_rtp.h.
+#define PF_MIDI_SYNC_HEARTBEAT_MS 4000
+#define PF_MIDI_SYNC_RETRY_MS 1000
+#define PF_MIDI_SYNC_UNANSWERED 8
+
+// The Wi-Fi up for 30 s with no session and at least two invitations
+// unanswered: the panel drops and rejoins the Wi-Fi, at most once every
+// 2 minutes. For what the rest cannot see - an association with a FlowLocal
+// that restarted too fast for the panel to notice, or one that stopped
+// carrying anything. 30 s rather than the 60 s of 2026-09-25: on 2026-09-27
+// the panel sat 48 s on the hotspot inviting into nothing until this
+// reconnect let it through. A FlowLocal that answers at all does so well
+// inside 30 s - seven invitations, each sent three times - and its NO starts
+// the count over. core_midi_rtp.h.
+#define PF_MIDI_WIFI_HEAL_MS 30000
+
+// K1-K3 out as the exhibit's knob positions. The exhibit feature keeps one
+// position per knob, 0..1, that every pattern draws with; this makes CC
+// 24-26 that same position, round(position x 127), so the sound and the
+// picture cannot drift apart - at the ends, across a K4 switch, or at the
+// idle return, which puts the positions (and so the CCs) back at their
+// starts. It also re-sends the three CCs right after the Program Change
+// when FlowLocal's session joins. End to end is PF_EXHIBIT_KNOB_DETENTS
+// detents (32, about a turn and a half), starting at
+// PF_EXHIBIT_KNOB_START_n (0.5 = CC 64): features/exhibit/exhibit_config.h.
+// Neither the /midi page's Sensitivity nor its Relative/Absolute choice
+// applies to them in this build.
+#define PF_MIDI_OUT_LANE_ABSOLUTE 1
+
+// Outbound sensitivity for a knob that has no lane in the frame - which in
+// this build is none of the ones that send (K4 never reaches MIDI, and
+// K1-K3 always carry the exhibit's lane except on the frame of a press,
+// which moves nothing). Kept at 4 so the one rare case moves at the scale
+// the knobs used to: clicks from the console's POST /api/params dN, which
+// knock that knob's lane off for five seconds and go out through this
+// multiplier (x4 per click) until the lane is back and the CC returns to
+// the position. An inbound MIDI CC 24-26 knocks the lane off too, but MIDI
+// never echoes what it received, so it sends nothing. A default only: a
+// gain ever saved on /midi (per knob, NVS "pf_midi") wins over it.
+#define PF_MIDI_OUT_MULTIPLIER 4
