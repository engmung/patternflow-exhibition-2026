+inline bool running = true;      // RUNNING mode (not SELECT)
+inline bool chromeUp = false;    // the device's own UI owns the knobs
+inline bool sleeping = false;    // as of the last onSleep (one frame behind the core)
+inline int  accum = 0;           // K4 detents not yet a whole step
+inline int  pendingIdx = -1;     // the switch to hand to takePattern
+inline int  handedIdx = -1;      // the switch takePattern handed over last frame
+inline bool bootPending = PF_EXHIBIT_BOOT_DEFAULT != 0;
+inline bool idleSpent = false;   // this idle period has had its return
+inline bool wakeGuard = false;
+inline uint32_t wakeGuardUntilMs = 0;
+inline bool restTaken = false;   // the knob variables' starting values are saved
+
+// Caption
+inline int  captionIdx = -1;     // the pattern the caption state belongs to
+inline bool captionOn = false;
+inline uint32_t captionStartMs = 0;
+
+// ── Shared with the network core ────────────────────────────────────────
+inline std::atomic<uint32_t> lastInputMs{0};
+inline std::atomic<int> activeSlot{-1};
+inline std::atomic<uint32_t> switches{0};
+inline std::atomic<uint32_t> idleReturns{0};
+// Captions on or off. PF_EXHIBIT_CAPTION is the value until /api/exhibit
+// stores one (NVS "pf_exhibit" / "caption"); the stored one wins after that.
+inline std::atomic<bool> captionsEnabled{PF_EXHIBIT_CAPTION != 0};
+inline std::atomic<bool> captionStored{false};
+
+// ── K1-K3: one position per knob ────────────────────────────────────────
+//
+// Why. A pattern integrates its own parameter from detents (PFParams::apply:
+// its own step, clamped at its own ends), and the midi feature integrated
+// its own CC position from the same detents (x4 per detent, clamped at
+// 0..127). Two integrators of one hand drift apart: at an end one stops and
+// the other runs on; a K4 switch hands the next pattern ITS old value while
+// the CC stays where it was; the idle return put the patterns' values back
+// and left the CC. The room saw one thing and heard another.
+//
+// So this feature owns the knob. One detent count per knob, 0..KNOB_DETENTS,
+// integrated here from the physical frame (fillInput) and handed on as a
+// LANE - the frame's knobAudioActive/knobAudioValue, an absolute 0..1
+// reading - instead of as detents. PFParams::apply maps a lane straight into
+// the parameter's own range, lo + (hi - lo) x position (abi/pf_params.h), and
+// returns before it looks at knobDeltas; the midi feature, built with
+// PF_MIDI_OUT_LANE_ABSOLUTE, sends the same lane as round(position x 127).
+// The hand's detents are taken out of the frame, so neither PFParams nor the
+// midi feature integrates them a second time. (A reader of raw knobDeltas
+// still sees motion on K1-K3 - the core's lane motion, not the hand's and
+// not the position: see "What a raw-delta reader sees" below.) An integer
+// count rather than a float that adds 1/N per detent: the same knob position
+// is the same value however many turns it took to get there.
+//
+// How the lane reaches the pattern, in the sketch's frame (patternflow.ino):
+// fillInput below sets it for K1-K3 on every frame; the midi feature's
+// fillInput (after this one) only adds inbound MIDI on top; the absolute bus
+// (fillAbsolute) clears a lane only on a channel something holds;
+// applyLaneMotion keeps it while the panel is RUNNING with neither the
+// brightness nor the NETWORK screen up (both locked here) and the frame has
+// carried no knobDeltas on that knob for five seconds - a delta is its "hand
+// on the knob" signal, and this feature has already taken the hand's out.
+// PFParams::apply then reads it. What can still take a knob away from its
+// position - none of it from the panel, and none of it in the exhibit, where
+// FlowLocal forwards nothing to the panel and nobody uses the console:
+//   - an absolute value on the bus: a console knob slider (POST /api/params
+//     pN), an inbound MIDI CC 20-22. The pattern follows that value and the
+//     CC does not move, until a hand turns that knob, which releases the bus
+//     as it always has. While it held, the bus fed the pattern compatibility
+//     clicks, and applyLaneMotion counts those as a hand: for up to five
+//     seconds after the held value last moved, the pattern and the CC both
+//     stay where they are, then land on the position together.
+//   - relative clicks added after this hook: POST /api/params dN, an inbound
+//     MIDI CC 24-26. They are a delta in the frame, so applyLaneMotion drops
+//     the lane for five seconds and the pattern takes the clicks through its
+//     own step. For those five seconds a visitor's turns on that knob reach
+//     neither the picture nor the sound (they still move the position, which
+//     nothing reads until the lane is back); then both land on the position.
+//     dN clicks also move the CC meanwhile, through the midi feature's own
+//     integrator (x outMul per click); an inbound CC does not, because MIDI
+//     never echoes what it received.
+//   - with PF_EXHIBIT_LOCK_MENUS 0 the device's own screens use K1-K3's
+//     detents, which this feature then leaves in the frame (see fillInput) -
+//     and five seconds of hands-off follow them.
+//
+// What a raw-delta reader sees. applyLaneMotion (patternflow.ino, after this
+// hook) turns an active lane into clicks in knobDeltas on every frame:
+// round((value - last value) x PF_LANE_MOTION_SCALE), 48 in this tree, so
+// 1.5 clicks per detent at 32 detents (2,1,2,1), stopping at the ends of the
+// position. On the first frame a lane is back after a frame without it, it
+// measures from 0.5 - so after every K1-K3 press (see below) that knob gets
+// round((position - 0.5) x 48) clicks at once, up to 24. PFParams ignores
+// them (a lane returns first) and so does the midi feature (nothing counts
+// under a lane), which is why the patterns and the CCs stay exact. A reader
+// of raw knobDeltas does not: the core's calibration card, which GET
+// /api/display?screen=N raises over the running pattern (its K1 steps the
+// screen, its K2 moves White Lv by 8 per click - in this build 1-2 steps per
+// detent, and after a K2 press at either end a jump of about 192), and a
+// legacy .pfm module picked from the console. Drive the card with
+// /api/display's screen= and level= instead. input.knobs[] is the raw
+// hardware count, never touched here: a pattern reading it follows the hand
+// with no ends. Either way such a pattern's picture drifts from CC 24-26,
+// which is why the exhibit's host test fails a pattern that reads them.
+//
+// One knob, one frame, on purpose without the lane: the frame in which that
+// knob's button is PRESSED. Patterns - Origin, HEOEUNBIN, whatever Pattern
+// Lab exports - act on a press only while the knob is not remote-driven
+// (`btnPressed[i] && !paramAbsoluteActive[i] && !knobAudioActive[i]`), and
+// here the lane IS the hand; with it set, HEOEUNBIN's K1 and K2 presses
+// would do nothing. Without the lane and with no detents, PFParams::apply
+// leaves the parameter where the last frame put it, and the next frame's
+// lane puts it on the position again (a turn made in the very frame of the
+// press shows one frame late). The midi feature sends nothing new for that
+// knob in that frame and catches up on the next one. A press that RESETS a
+// knob's parameter (Origin's) lasts that one frame: the position wins.
+constexpr int KNOBS = 3;   // K1-K3; K4 is the pattern switch
+constexpr int KNOB_DETENTS = PF_EXHIBIT_KNOB_DETENTS;
+
+constexpr int startDetent(float start) { return (int)(start * (float)KNOB_DETENTS + 0.5f); }
+static_assert(PF_EXHIBIT_KNOB_START_1 >= 0.0f && PF_EXHIBIT_KNOB_START_1 <= 1.0f,
+              "PF_EXHIBIT_KNOB_START_1 must be 0..1");
+static_assert(PF_EXHIBIT_KNOB_START_2 >= 0.0f && PF_EXHIBIT_KNOB_START_2 <= 1.0f,
+              "PF_EXHIBIT_KNOB_START_2 must be 0..1");
+static_assert(PF_EXHIBIT_KNOB_START_3 >= 0.0f && PF_EXHIBIT_KNOB_START_3 <= 1.0f,
+              "PF_EXHIBIT_KNOB_START_3 must be 0..1");
+constexpr int KNOB_START[KNOBS] = {startDetent(PF_EXHIBIT_KNOB_START_1),
+                                   startDetent(PF_EXHIBIT_KNOB_START_2),
+                                   startDetent(PF_EXHIBIT_KNOB_START_3)};
+
+// Detents up from the low end, 0..KNOB_DETENTS. Written on the frame task
+// only; atomic because /api/status reads it on the network core.
+inline std::atomic<int> knobDetent[KNOBS] = {KNOB_START[0], KNOB_START[1], KNOB_START[2]};
+
+inline float knobPos(int i) {
+  return (float)knobDetent[i].load(std::memory_order_relaxed) / (float)KNOB_DETENTS;
+}
+
+inline void resetKnobs() {
+  for (int i = 0; i < KNOBS; i++) knobDetent[i].store(KNOB_START[i], std::memory_order_relaxed);
+}
+
+// The hand's detents on K1-K3 into the positions, and out of the frame.
+// `integrate` false drops them instead (asleep: the turn that wakes the
+// panel is spent on waking it - the sketch skips that frame's pattern).
+inline void moveKnobs(InputFrame& input, bool integrate) {
+  for (int i = 0; i < KNOBS; i++) {
+    const int d = input.knobDeltas[i];
+    input.knobDeltas[i] = 0;
+    if (!integrate || d == 0) continue;
+    int n = knobDetent[i].load(std::memory_order_relaxed) + d;
+    if (n < 0) n = 0;
+    if (n > KNOB_DETENTS) n = KNOB_DETENTS;
+    knobDetent[i].store(n, std::memory_order_relaxed);
+  }
+}
+
+// The positions into the frame as K1-K3's lanes - except on a knob whose
+// button went down in this frame (see above).
+inline void driveLanes(InputFrame& input) {
+  for (int i = 0; i < KNOBS; i++) {
+    input.knobAudioActive[i] = !input.btnPressed[i];
+    input.knobAudioValue[i] = knobPos(i);
+  }
+}
+
+constexpr const char* NVS_NAMESPACE = "pf_exhibit";
+
+// Slot within the exhibit list (0..COUNT-1), or -1 for anything else - Origin,
+// a module picked from the console.
+inline int slotOf(int idx) {
+  if (!rangeOk || idx < firstIdx || idx >= firstIdx + COUNT) return -1;
+  return idx - firstIdx;
+}
+
+inline void loadCaptionSetting() {
+  Preferences p;
+  if (!p.begin(NVS_NAMESPACE, true)) return;   // never stored: the build's default
+  if (p.isKey("caption")) {
+    captionsEnabled.store(p.getBool("caption", PF_EXHIBIT_CAPTION != 0), std::memory_order_relaxed);
+    captionStored.store(true, std::memory_order_relaxed);
+  }
+  p.end();
+}
+
+// From /api/exhibit, on the network core. mode: 0 off, 1 on, -1 forget the
+// stored value and go back to the build's PF_EXHIBIT_CAPTION.
+inline bool setCaptions(int mode) {
+  Preferences p;
+  if (!p.begin(NVS_NAMESPACE, false)) return false;
+  bool ok;
+  if (mode < 0) {
+    ok = !p.isKey("caption") || p.remove("caption");
+    if (ok) {
+      captionsEnabled.store(PF_EXHIBIT_CAPTION != 0, std::memory_order_relaxed);
+      captionStored.store(false, std::memory_order_relaxed);
+    }
+  } else {
+    ok = p.putBool("caption", mode != 0) > 0;
+    if (ok) {
+      captionsEnabled.store(mode != 0, std::memory_order_relaxed);
+      captionStored.store(true, std::memory_order_relaxed);
+    }
+  }
+  p.end();
+  Serial.printf("[EXHIBIT] captions %s%s\n",
+                captionsEnabled.load(std::memory_order_relaxed) ? "on" : "off",
+                ok ? "" : " (NVS write failed)");
+  return ok;
+}
+
+inline void setup() {
+  lastInputMs.store(millis(), std::memory_order_relaxed);
+  loadCaptionSetting();
+  // Which slot each pattern that marks a moment sits in. Before the range
+  // check below returns: the rows are matched against the caption table, not
+  // against the registry, so they are right either way.
+  PatternflowExhibitPulse::begin();
+  firstIdx = NUM_PRESETS - COUNT;
+  rangeOk = COUNT > 0 && firstIdx >= 0;
+  // The rows are the tail of presetPatterns[] only if the composition put
+  // them there and nothing after them. Compare what the registry holds with
+  // what the list says, by setup() pointer: if they disagree, K4 would hand
+  // a visitor somebody else's pattern under an artist's caption. Refuse
+  // instead, loudly, and leave the panel on whatever it runs.
+  for (int i = 0; rangeOk && i < COUNT; i++) {
+    if (presetPatterns[firstIdx + i].setup != PFExhibitPresets::CAPTIONS[i].setup) rangeOk = false;
+  }
+  if (!rangeOk) {
+    firstIdx = -1;
+    Serial.printf("[EXHIBIT] ERROR: the %d exhibit patterns are not the last entries of "
+                  "presetPatterns[] - check PF_FEATURE_PRESETS in overrides.h. "
+                  "Pattern switching is off.\n", COUNT);
+    return;
+  }
+  int slot = PF_EXHIBIT_DEFAULT_SLOT;
+  if (slot < 0 || slot >= COUNT) {
+    Serial.printf("[EXHIBIT] PF_EXHIBIT_DEFAULT_SLOT %d is outside 0..%d - using 0\n", slot, COUNT - 1);
+    slot = 0;
+  }
+  defaultIdx = firstIdx + slot;
+  Serial.printf("[EXHIBIT] %d patterns at %d..%d, default %d (%s), captions %s\n", COUNT, firstIdx,
+                firstIdx + COUNT - 1, defaultIdx, presetPatterns[defaultIdx].name,
+                captionsEnabled.load(std::memory_order_relaxed) ? "on" : "off");
+}
+
+// ── Knob values the idle return puts back ───────────────────────────────
+// Taken on the first frame: every preset's setup() has run by then (it runs
+// at the end of the sketch's setup(), after this feature's) and no input has
+// reached a pattern yet.
+inline uint8_t restSnapshot[PFExhibitPresets::REST_SLOTS * PFExhibitPresets::REST_VAR_BYTES];
+
+inline void takeRestSnapshot() {
+  for (int i = 0; i < PFExhibitPresets::REST_COUNT; i++) {
+    const PFExhibitPresets::RestVar& v = PFExhibitPresets::REST_VARS[i];
+    memcpy(restSnapshot + i * PFExhibitPresets::REST_VAR_BYTES, v.addr, v.size);
+  }
+  restTaken = true;
+}
+
+inline void restoreRest() {
+  if (!restTaken) return;
+  for (int i = 0; i < PFExhibitPresets::REST_COUNT; i++) {
+    const PFExhibitPresets::RestVar& v = PFExhibitPresets::REST_VARS[i];
+    memcpy(v.addr, restSnapshot + i * PFExhibitPresets::REST_VAR_BYTES, v.size);
+  }
+}
+
+// A person did something. Restarts the idle clock and re-arms the return.
+inline void noteInput(uint32_t now) {
+  lastInputMs.store(now, std::memory_order_relaxed);
+  idleSpent = false;
+}
+
+// ── The idle return ─────────────────────────────────────────────────────
+// Decided at the top of the frame (the loop hook), not in takePattern at the
+// bottom where it used to be: the knob positions go back to their starts in
+// the same step, and this frame's fillInput then hands the patterns - and the
+// midi feature - the start positions. Decided in takePattern, the frame that
+// switches to the default pattern would still carry the last visitor's
+// positions, so the default pattern would run one frame on them right after
+// its variables had been put back (CHOEGYEONGEUN reads a door closing and
+// opening again as a scene change, and one frame is enough for that).
+//
+// Not while the panel sleeps, and not in the frame after it wakes (`sleeping`
+// is still set then, and onSleep(false) restarts the idle clock later in that
+// frame): takePattern, the old place, is never reached while it sleeps
+// either, so a panel woken from the console after an hour is not reset under
+// whoever woke it. The one frame this can still meet is the one in which a
+// sleep lands: onSleep(true) then drops the switch, and the positions are
+// back at their starts while it sleeps - which is where they would have gone.
+inline void idleReturnIfDue() {
+#if PF_EXHIBIT_IDLE_RETURN_MS > 0
+  if (!rangeOk || idleSpent || sleeping || PatternflowSleep::isSleeping()) return;
+  const uint32_t idleFor = millis() - lastInputMs.load(std::memory_order_relaxed);
+  if (idleFor < (uint32_t)PF_EXHIBIT_IDLE_RETURN_MS) return;
+  // Once per idle period. Spent even when already on the default, so the
+  // knobs are put back once and a quiet panel is left alone after that. A
+  // pick from the console restarts the clock (loop below), so it gets its
+  // own full idle period before the panel comes back.
+  idleSpent = true;
+  accum = 0;           // the last visitor's leftover K4 detents
+  restoreRest();       // every pattern's listed variables back where they started
+  resetKnobs();        // and K1-K3 back to their starts, for the picture and the sound
+  if (pendingIdx < 0 && currentIdx != defaultIdx) {
+    pendingIdx = defaultIdx;
+    idleReturns.fetch_add(1, std::memory_order_relaxed);
+    Serial.printf("[EXHIBIT] idle %lu ms - back to %s\n", (unsigned long)idleFor,
+                  presetPatterns[defaultIdx].name);
+  }
+#endif
+}
+
+inline void loop(const PFFeatureFrame& frame) {
+  if (!restTaken) takeRestSnapshot();
+  // A pattern change this feature did not hand over - the console's picker,
+  // an inbound Program Change - is somebody choosing, so it restarts the idle
+  // clock. Otherwise a pick made 170 s after the last touch would be undone
+  // ten seconds later. (The first frame is skipped: that change is the boot
+  // restore, not a pick.)
+  if (currentIdx >= 0 && frame.patternIndex != currentIdx && frame.patternIndex != handedIdx) {
+    noteInput(millis());
+  }
+  // A moment flagged by the pattern that has just left the panel is not this
+  // one's to sound. It cannot normally survive a frame - drawOverlay reads
+  // and clears it in the frame the pattern drew - but a frame the sketch
+  // never renders (a module loading, the calibration card) would leave one
+  // raised, and it would go out under the next picture.
+  if (frame.patternIndex != currentIdx) PatternflowExhibitPulse::clearAll();
+  handedIdx = -1;
+  currentIdx = frame.patternIndex;
+  running = frame.running;
+  chromeUp = frame.chromeVisible;
+  activeSlot.store(slotOf(currentIdx), std::memory_order_relaxed);
+  idleReturnIfDue();
+  // The note-offs owed from earlier frames. Here rather than beside the
+  // note-ons in drawOverlay because this hook runs on every frame there is,
+  // including the ones where nothing is drawn: a note that went out just
+  // before the panel stopped rendering still has to come up.
+  PatternflowExhibitPulse::service(millis());
+}
+
+// ── The menu lock ───────────────────────────────────────────────────────
+//
+// The core opens its long-press screens with Button::longPressed() - K1
+// brightness, K2 NETWORK (behind which sit sleep and the UPDATE screen), K3
+// knob map, K4 SELECT - four calls in patternflow.ino's loop(), all of them
+// AFTER readInputFrame(). longPressed() fires only while the button's
+// `longPressFired` is false, and Button::pressed() - called once per button
+// per frame by readInputFrame, BEFORE PFFeatures::fillInput - clears it on
+// the press edge. So setting it here, every frame, lands after the only
+// place that clears it and before every place that reads it, and no hold
+// ever crosses the threshold as far as the core can tell. The core does the
+// same thing itself to retire a hold that woke the panel (patternflow.ino,
+// the wake branch: `b->longPressFired = true`).
+//
+// All four physical Button objects are set, not the logical ones: the
+// core's logicalButton() maps through LOGICAL_TO_PHYSICAL_KNOB (an identity
+// today), and the /knobs page remaps encoder direction and click size only,
+// never buttons - so this covers every mapping there is.
+//
+// THIS DEPENDS ON src/core_encoders.h INTERNALS: the field's name, that
+// pressed() is the one place that clears it, and that a release with the
+// flag set is not a click. The side effect of the last one is that
+// Button::clicked() never reports a click while the lock is on - which the
+// core uses to leave its screens, and (while no screen is up) to report
+// onUserInput; fillInput below counts press edges itself for that. Patterns
+// and MIDI read btnPressed/btnHeld, which pressed() and isDown() fill
+// regardless. One screen can still come up without a hold: the UPDATE card,
+// which a firmware upload from the console raises, and which a failed upload
+// leaves on the panel ("FAILED ... K4 = EXIT"). Its exits are a K4 click and
+// ten minutes without a knob turn, so fillInput makes both work: a K4 press
+// while it is up is handed to the core as a click (btn4.clickedFlag), and
+// the knobs are taken out of the frame so a visitor's turns do not keep
+// restarting its timer. The core ignores the click while an upload is still
+// running or the reboot is pending.
+// If core_encoders.h changes how a hold or a click is detected, re-check this.
+inline void lockMenus() {
+  btn1.longPressFired = true;
+  btn2.longPressFired = true;
+  btn3.longPressFired = true;
+  btn4.longPressFired = true;
+}
+
+// One step along the exhibit list from idx. The rows are registered hidden
+// (exhibit_presets.h), so there is nothing to skip.
+inline int stepFrom(int idx, int dir) {
+  return firstIdx + ((idx - firstIdx + dir) % COUNT + COUNT) % COUNT;
+}
+
+inline void step(int steps) {
+  const int dir = steps > 0 ? 1 : -1;
+  int n = steps > 0 ? steps : -steps;
+  // From the switch already asked for, if one is still waiting; a fast
+  // hand can outrun the frame that performs it.
+  int idx = pendingIdx >= 0 ? pendingIdx : currentIdx;
+  if (slotOf(idx) < 0) {
+    // Not on an exhibit pattern (Origin, or something the console picked):
+    // the first step enters the list at its start, or its end going back.
+    idx = dir > 0 ? firstIdx : firstIdx + COUNT - 1;
+    n--;
+  }
+  n %= COUNT;   // a full lap in one frame lands where it started
+  while (n-- > 0) idx = stepFrom(idx, dir);
+  pendingIdx = idx == currentIdx ? -1 : idx;
+  if (pendingIdx >= 0) switches.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Before the pattern sees the frame. This feature is FIRST in the list, so
+// what is in `input` here is readInputFrame's physical reading and nothing
+// any other feature merged in yet.
+inline void fillInput(InputFrame& input) {
+#if PF_EXHIBIT_LOCK_MENUS
+  lockMenus();
+#endif
+
+  // A hand on anything restarts the idle clock. Turns and press EDGES, not
+  // held levels: a visitor holding a button pressed it first, and a switch
+  // stuck closed must not hold off the idle return for the rest of the day.
+  // onUserInput() below hears the turns too; this also covers the presses,
+  // which the core only reports as clicks - and the lock above means there
+  // are none.
+  for (int i = 0; i < 4; i++) {
+    if (input.knobDeltas[i] != 0 || input.btnPressed[i]) {
+      noteInput(input.now);
+      break;
+    }
+  }
+
+#if !PF_EXHIBIT_PASS_BUTTONS
+  for (int i = 0; i < 3; i++) {
+    input.btnPressed[i] = false;
+    input.btnHeld[i] = false;
+  }
+#endif
+
+  // The device's own UI owns the knobs (SELECT or a screen): K4 is its
+  // business, not a pattern switch, and K1-K3's detents are its too - the
+  // positions stay where they are and the lanes carry them unchanged.
+  if (!running || chromeUp) {
+    accum = 0;
+#if PF_EXHIBIT_LOCK_MENUS
+    // With the lock on, the only screen that can be up is the UPDATE card
+    // (see lockMenus). K4 = EXIT, as the card says; and no knob restarts its
+    // idle timer. The core swallows these fields while the card is up
+    // anyway, so nothing else loses them.
+    if (chromeUp) {
+      if (input.btnPressed[3]) btn4.clickedFlag = true;
+      for (int i = 0; i < 4; i++) {
+        input.knobDeltas[i] = 0;
+        input.btnPressed[i] = false;
+      }
+      input.btnHeld[3] = false;
+    }
+#endif
+    driveLanes(input);
+    return;
+  }
+
+  // The panel's own sleep state, read live: this feature's `sleeping` only
+  // learns of a wake from the onSleep after this hook.
+  const bool asleepNow = PatternflowSleep::isSleeping();
+
+  // K1-K3 (see "K1-K3" above): the hand moves the shared positions, and the
+  // frame carries the positions, not the hand's detents.
+  moveKnobs(input, !asleepNow);
+  driveLanes(input);
+
+  // K4 is the switch and nothing else sees it. Its press stays in the frame
+  // only while the panel sleeps, because a press is one of the things that
+  // wakes it (patternflow.ino reads btnPressed there). That is the core's
+  // own state, read live (asleepNow above), and a press let through in the
+  // frame after a wake would be a MIDI note-on 63 with no note-off.
+  // input.knobs[] - the absolute count sleep compares against - is never
+  // touched, for any knob.
+  const int d = input.knobDeltas[3];
+  input.knobDeltas[3] = 0;
+  input.btnHeld[3] = false;
+  if (!asleepNow) input.btnPressed[3] = false;
+  if (d == 0) return;
+
+  if (wakeGuard && (int32_t)(wakeGuardUntilMs - input.now) <= 0) wakeGuard = false;
+  // `sleeping` still true here is the frame right after a wake, before
+  // onSleep has armed the wake guard: the turn that woke the panel.
+  if (asleepNow || sleeping || wakeGuard || !rangeOk) {
+    accum = 0;
+    return;
+  }
+  accum += d;
+  const int steps = accum / PF_EXHIBIT_DETENTS_PER_STEP;   // truncates toward zero
+  accum -= steps * PF_EXHIBIT_DETENTS_PER_STEP;            // so a reversal cancels
+  if (steps != 0) step(steps);
+}
+
+inline void onUserInput() { noteInput(millis()); }
+
+// "Switch to this pattern, please" - the sketch performs it, in this frame.
+// Exhibit patterns are presets, and a preset switches at once
+// (pattern_registry.h, activatePatternAsync). This feature only ASKS, so the
+// sketch treats the pick as a person's and remembers it; boot puts the
+// default back regardless. The idle return's switch is decided in the loop
+// hook (idleReturnIfDue) and handed over here like a K4 one.
+inline bool takePattern(int* idx) {
+  if (bootPending) {
+    bootPending = false;
+    if (rangeOk && currentIdx != defaultIdx) {
+      pendingIdx = defaultIdx;
+    } else {
+      captionIdx = -1;   // already there: still announce it once
+    }
+  }
+
+  if (pendingIdx < 0) return false;
+  *idx = pendingIdx;
+  handedIdx = pendingIdx;
+  pendingIdx = -1;
+  return true;
+}
+
+// Called every frame with the current state; acts on the edges.
+inline void onSleep(bool s) {
+  if (s == sleeping) return;
+  sleeping = s;
+  accum = 0;
+  pendingIdx = -1;
+  if (s) {
+    // Nothing is drawn from here on, so nothing may sound: drop whatever the
+    // last rendered frame flagged and let go of every note that is still
+    // down, rather than hold one for as long as the panel sleeps.
+    PatternflowExhibitPulse::clearAll();
+    PatternflowExhibitPulse::flush();
+  }
+  if (!s) {
+    // The turn that woke the panel is still under the hand.
+    wakeGuard = true;
+    wakeGuardUntilMs = millis() + PF_EXHIBIT_WAKE_GUARD_MS;
+    noteInput(millis());
+  }
+}
+
+// ── The caption ─────────────────────────────────────────────────────────
+//
+// Where it goes, and why there. drawOverlay runs in RUNNING mode, after the
+// pattern has presented and before the core's own "content notice" - the
+// pattern NAME the sketch flashes, centred on the portrait panel, for one
+// second after a switch. The exhibit's rows are registered hidden
+// (exhibit_presets.h), and the core does not flash a hidden pattern's name
+// when a feature picks it, so a K4 switch, the idle return and the boot
+// default show this caption alone. A pick from the console still gets the
+// core's flash on top. The caption is a lower third, out of that flash's way:
+// artist in LED orange above the title in white, packed up from the bottom
+// edge, each line on the same tight black scrim the core's cards use.
+//
+// Text wrap. Adafruit GFX wraps text at the screen's right edge by default,
+// and nothing in the tree turns that off. With it on, getTextBounds() never
+// reports a line wider than the screen - so a word-wrap that measures lines
+// with it never finds one too wide, and print() then breaks the text
+// mid-word and runs it off the bottom of the panel. drawCaption turns wrap
+// off while it measures and draws, and back on (the library default, which
+// the core's own text relies on) before it returns.
+//
+// Nothing here calls present() or flips a buffer: GFX primitives straight
+// onto the panel between the blit and the sketch's flip, like every other
+// overlay. The font, the rotation and text wrap are put back the way they
+// were found.
+
+constexpr int CAPTION_MAX_TITLE_LINES = 3;
+constexpr int CAPTION_MAX_ARTIST_LINES = 2;
+constexpr size_t CAPTION_LINE_BYTES = 40;
+
+// The panel font is 1-byte ASCII. Anything else becomes one '?' per
+// character rather than a burst of wrong glyphs.
+inline void asciiOnly(const char* src, char* out, size_t cap) {
+  size_t w = 0;
+  for (const uint8_t* p = (const uint8_t*)(src ? src : ""); *p && w + 1 < cap;) {
+    if (*p >= 0x20 && *p <= 0x7e) {
+      out[w++] = (char)*p++;
+      continue;
+    }
+    out[w++] = '?';
+    p++;
+    while ((*p & 0xc0) == 0x80) p++;
+  }
+  out[w] = '\0';
+}
+
+// Word-wrap into at most maxLines lines of maxW pixels in the chosen font.
+// Returns the line count, or 0 when a single word will not fit and
+// hardBreak is off - the caller then tries the smaller font. Text past
+// maxLines is dropped. Needs text wrap OFF (see above).
+inline int wrapLines(void (*chooseFont)(), const char* text, int maxW,
+                     char lines[][CAPTION_LINE_BYTES], int maxLines, bool hardBreak) {
+  char buf[96];
+  snprintf(buf, sizeof(buf), "%s", text);
+  int16_t x1, y1;
+  uint16_t w, h;
+  int n = 0;
+  char* cursor = buf;
+  while (*cursor && n < maxLines) {
+    while (*cursor == ' ') cursor++;
+    if (!*cursor) break;
+    char* lineStart = cursor;
+    char* lastSpace = nullptr;
+    char* p = cursor;
+    while (*p) {
+      if (*p == ' ') lastSpace = p;
+      const char saved = p[1];
+      p[1] = '\0';
+      PatternflowUiText::boundsWith(chooseFont, lineStart, &x1, &y1, &w, &h);
+      p[1] = saved;
+      if ((int)w > maxW) break;
+      p++;
+    }
+    const bool wordBoundary = lastSpace && lastSpace > lineStart;
+    if (*p && !wordBoundary && !hardBreak) return 0;   // one word too wide
+    if (p == lineStart) p++;                           // one glyph too wide: take it anyway
+    char* cut = (*p && wordBoundary) ? lastSpace : p;
+    const char keep = *cut;
+    *cut = '\0';
+    snprintf(lines[n++], CAPTION_LINE_BYTES, "%s", lineStart);
+    *cut = keep;
+    cursor = (keep == ' ') ? cut + 1 : cut;
+  }
+  return n;
+}
+
+// Lines in the name font (the stock 5x7, easiest to read from a step back),
+// or the compact font when a word does not fit. Returns the pitch used.
+inline int layoutLines(const char* text, int maxW, char lines[][CAPTION_LINE_BYTES],
+                       int maxLines, int* count, void (**font)()) {
+  *font = PatternflowUiText::useNameFont;
+  *count = wrapLines(*font, text, maxW, lines, maxLines, false);
+  if (*count > 0) return uiSelectLinePitch();
+  *font = PatternflowUiText::useChromeFont;
+  *count = wrapLines(*font, text, maxW, lines, maxLines, true);
+  return uiLinePitch();
+}
+
+inline void drawCaption(int slot, int idx) {
+  const PFExhibitPresets::Caption& c = PFExhibitPresets::CAPTIONS[slot];
+  char artist[48];
+  char title[64];
+  asciiOnly(c.artist, artist, sizeof(artist));
+  asciiOnly((c.title && c.title[0]) ? c.title : presetPatterns[idx].name, title, sizeof(title));
+
+  const uint8_t prevRotation = dma_display->getRotation();
+  dma_display->setRotation(PF_EXHIBIT_CAPTION_ROTATION);
+  dma_display->setTextWrap(false);   // measure and print real widths (see above)
+  const int W = dma_display->width();
+  const int H = dma_display->height();
+  const int maxW = W - 4;
+
+  char titleLines[CAPTION_MAX_TITLE_LINES][CAPTION_LINE_BYTES];
+  char artistLines[CAPTION_MAX_ARTIST_LINES][CAPTION_LINE_BYTES];
+  int titleCount = 0;
+  int artistCount = 0;
+  void (*titleFont)() = nullptr;
+  void (*artistFont)() = nullptr;
+  const int titlePitch = layoutLines(title, maxW, titleLines, CAPTION_MAX_TITLE_LINES,
+                                     &titleCount, &titleFont);
+  const int artistPitch = artist[0] ? layoutLines(artist, maxW, artistLines,
+                                                  CAPTION_MAX_ARTIST_LINES, &artistCount,
+                                                  &artistFont)
+                                    : 0;
+
+  // Packed up from the bottom edge: title last, artist above it.
+  const int titleTop = H - 3 - titleCount * titlePitch;
+  const int artistTop = titleTop - 2 - artistCount * artistPitch;
+  const uint16_t orange = dma_display->color565(232, 85, 46);
+  const uint16_t white = dma_display->color565(255, 255, 255);
+  for (int i = 0; i < artistCount; i++) {
+    PatternflowUiText::drawLine(artistFont, artistLines[i], artistTop + i * artistPitch, orange);
+  }
+  for (int i = 0; i < titleCount; i++) {
+    PatternflowUiText::drawLine(titleFont, titleLines[i], titleTop + i * titlePitch, white);
+  }
+
+  PatternflowUiText::useDefaultFont();
+  dma_display->setTextWrap(true);    // the library default; nothing in the tree changes it
+  dma_display->setRotation(prevRotation);
+}
+
+inline void drawOverlay(const PFFeatureFrame& frame) {
+  const int idx = frame.patternIndex;
+  const uint32_t now = millis();
+  // The moment the pattern flagged while it drew this frame, a few
+  // microseconds ago - the sketch calls this hook right after the pattern's
+  // update() and draw() (exhibit_pulse.h). First, before any of the caption's
+  // returns below, and whatever the caption is doing: the sound does not
+  // depend on a decision about text. The knobs are not consulted either - a
+  // brightness bar up over a running pattern is still a running pattern.
+  if (frame.running) PatternflowExhibitPulse::onFrame(slotOf(idx), now);
+  // Any change of pattern starts a caption, whoever made it - K4, the idle
+  // return, boot, the console, a MIDI Program Change. Not before the boot
+  // decision: the pattern restored from NVS may be replaced in the same
+  // breath, and must not flash its caption on the way out. Tracked even
+  // while captions are off, so switching them on does not caption a change
+  // from long ago.
+  if (idx != captionIdx) {
+    captionIdx = idx;
+    captionOn = !bootPending && slotOf(idx) >= 0;
+    captionStartMs = now;
+  }
+  if (!captionOn) return;
+  if ((uint32_t)(now - captionStartMs) >= (uint32_t)PF_EXHIBIT_CAPTION_MS) {
+    captionOn = false;
+    return;
+  }
+  if (!captionsEnabled.load(std::memory_order_relaxed)) return;
+  if (frame.chromeVisible || !frame.running) return;
+  const int slot = slotOf(idx);
+  if (slot >= 0) drawCaption(slot, idx);
+}
+
+// ── /api/status, from the network core ──────────────────────────────────
+// Only values written once in setup() (before this task existed), compile-
+// time constants, and atomics.
+inline void appendStatus(String& json) {
+  // The stamp first, then the clock: the frame task may store a newer stamp
+  // between two reads, and the other order would wrap round to ~49 days.
+  const uint32_t last = lastInputMs.load(std::memory_order_relaxed);
+  const uint32_t now = millis();
+  json += ",\"exhibit\":{\"rangeOk\":";
+  json += rangeOk ? "true" : "false";
+  json += ",\"first\":";
+  json += firstIdx;
+  json += ",\"count\":";
+  json += COUNT;
+  json += ",\"defaultIdx\":";
+  json += defaultIdx;
+  json += ",\"slot\":";
+  json += activeSlot.load(std::memory_order_relaxed);
+  json += ",\"idleMs\":";
+  json += (uint32_t)(now >= last ? now - last : 0);
+  json += ",\"idleReturnMs\":";
+  json += (uint32_t)PF_EXHIBIT_IDLE_RETURN_MS;
+  json += ",\"detentsPerStep\":";
+  json += (int)PF_EXHIBIT_DETENTS_PER_STEP;
+  json += ",\"menusLocked\":";
+  json += PF_EXHIBIT_LOCK_MENUS ? "true" : "false";
+  json += ",\"captions\":";
+  json += captionsEnabled.load(std::memory_order_relaxed) ? "true" : "false";
+  json += ",\"captionStored\":";
+  json += captionStored.load(std::memory_order_relaxed) ? "true" : "false";
+  json += ",\"restVars\":";
+  json += (int)PFExhibitPresets::REST_COUNT;
+  json += ",\"switches\":";
+  json += switches.load(std::memory_order_relaxed);
+  json += ",\"idleReturns\":";
+  json += idleReturns.load(std::memory_order_relaxed);
+  // K1-K3's shared positions, 0..1, as the patterns (and CC 24-26) have them.
+  json += ",\"knobDetents\":";
+  json += (int)KNOB_DETENTS;
+  json += ",\"knobPos\":[";
+  for (int i = 0; i < KNOBS; i++) {
+    if (i) json += ',';
+    char v[16];
+    snprintf(v, sizeof(v), "%.4f", (double)knobPos(i));
+    json += v;
+  }
+  json += "]}";
+}
+
+}  // namespace PatternflowExhibit
diff --git a/firmware/patternflow/features/exhibit/core_exhibit_http.h b/firmware/patternflow/features/exhibit/core_exhibit_http.h
new file mode 100644
index 0000000..b052377
--- /dev/null
+++ b/firmware/patternflow/features/exhibit/core_exhibit_http.h
@@ -0,0 +1,77 @@
+// ═══════════════════════════════════════════════════════════
+// PatternFlow - /api/exhibit: the one exhibit setting a person changes
+//
+//   GET|POST /api/exhibit                   captions on or off, and whether
+//                                           that is stored or the build's
+//   GET|POST /api/exhibit?caption=0|1       set it and remember it (NVS
+//                                           "pf_exhibit"), then the state
+//   GET|POST /api/exhibit?caption=default   forget it: PF_EXHIBIT_CAPTION
+//
+// A GET that writes, on purpose: the person deciding whether the captions
+// stay is standing in front of the panel with a phone, and a URL typed into
+// a browser is a GET. /api/patterns/select sets the precedent. The panel
+// lives on the venue's own hotspot, capped to the panel and one operator
+// phone, so nothing else on that network can follow a link here.
+//
+// The handler runs on the network core: it writes NVS and an atomic the
+// frame task reads, nothing else (core_exhibit.h, setCaptions).
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+
+#include <Arduino.h>
+
+#include "../../src/core_http.h"
+#include "core_exhibit.h"
+
+namespace PatternflowExhibitHttp {
+
+inline bool initialized = false;
+
+inline void sendState(bool ok = true) {
+  String json = "{\"ok\":";
+  json += ok ? "true" : "false";
+  json += ",\"caption\":";
+  json += PatternflowExhibit::captionsEnabled.load(std::memory_order_relaxed) ? "true" : "false";
+  json += ",\"captionStored\":";
+  json += PatternflowExhibit::captionStored.load(std::memory_order_relaxed) ? "true" : "false";
+  json += ",\"captionDefault\":";
+  json += PF_EXHIBIT_CAPTION ? "true" : "false";
+  if (!ok) json += ",\"error\":\"NVS write failed\"";
+  json += "}";
+  PatternflowHttp::server().send(ok ? 200 : 500, "application/json", json);
+}
+
+inline void handle() {
+  WebServer& s = PatternflowHttp::server();
+  if (!s.hasArg("caption")) {
+    sendState();
+    return;
+  }
+  const String v = s.arg("caption");
+  int mode;
+  if (v == "1" || v == "on") {
+    mode = 1;
+  } else if (v == "0" || v == "off") {
+    mode = 0;
+  } else if (v == "default") {
+    mode = -1;
+  } else {
+    s.send(400, "application/json",
+           "{\"ok\":false,\"error\":\"caption must be 0, 1 or default\"}");
+    return;
+  }
+  sendState(PatternflowExhibit::setCaptions(mode));
+}
+
+inline void begin() {
+  if (initialized) return;
+  initialized = true;
+  WebServer& s = PatternflowHttp::server();
+  s.on("/api/exhibit", HTTP_GET, handle);
+  s.on("/api/exhibit", HTTP_POST, handle);
+  PatternflowHttp::begin();
+}
+
+}  // namespace PatternflowExhibitHttp
diff --git a/firmware/patternflow/features/exhibit/exhibit_config.h b/firmware/patternflow/features/exhibit/exhibit_config.h
new file mode 100644
index 0000000..534de03
--- /dev/null
+++ b/firmware/patternflow/features/exhibit/exhibit_config.h
@@ -0,0 +1,174 @@
+// ═══════════════════════════════════════════════════════════
+// PatternFlow - exhibit feature: compile-time defaults
+//
+// Read only when a composition carries features/exhibit/. Every value is
+// #ifndef-guarded: patternflow_secrets.h (per device) and a composition's
+// overrides.h (per build) are included before this through config.h, so
+// whatever they define wins and the lines below fill in the rest.
+//
+// Nothing here is a runtime setting a visitor can reach. An unattended panel
+// in a room full of strangers is the one place a knob that changes behaviour
+// is a liability, so what the exhibit does is decided when the image is
+// built. One exception, reachable only over the panel's web server: captions
+// on or off (/api/exhibit, see PF_EXHIBIT_CAPTION below), because that is a
+// judgement made standing in front of the panel, not at a desk.
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+#include "../../config.h"
+
+// The device's own long-press screens - K1 brightness, K2 NETWORK (and the
+// UPDATE screen and sleep behind it), K3 knob map, K4 SELECT - cannot be
+// opened from the panel. Brightness stays reachable from the web console.
+// See lockMenus() in core_exhibit.h for how, and what it depends on.
+#ifndef PF_EXHIBIT_LOCK_MENUS
+#define PF_EXHIBIT_LOCK_MENUS 1
+#endif
+
+// K4 detents per pattern step. Three, like the core's own SELECT browser: a
+// hand that meant one pattern used to land two or three along at one per
+// detent. Whole steps switch; the remainder waits, and a change of direction
+// cancels it.
+#ifndef PF_EXHIBIT_DETENTS_PER_STEP
+#define PF_EXHIBIT_DETENTS_PER_STEP 3
+#endif
+
+// Nobody has touched a knob or a button for this long: go back to the
+// default exhibit pattern, once per idle period. 0 turns it off.
+#ifndef PF_EXHIBIT_IDLE_RETURN_MS
+#define PF_EXHIBIT_IDLE_RETURN_MS 180000
+#endif
+
+// 1 = every boot starts on the default exhibit pattern, whatever the panel
+// remembered from before the power went away.
+#ifndef PF_EXHIBIT_BOOT_DEFAULT
+#define PF_EXHIBIT_BOOT_DEFAULT 1
+#endif
+
+// Which exhibit pattern is the default: 0-based within the exhibit list
+// (exhibit_presets.h), not a registry index.
+#ifndef PF_EXHIBIT_DEFAULT_SLOT
+#define PF_EXHIBIT_DEFAULT_SLOT 0
+#endif
+
+// "ARTIST / Title" over the pattern after every switch, for CAPTION_MS.
+// This is the value a freshly flashed panel starts with. To change it on
+// site, open one of these in a browser on the same Wi-Fi (the operator's
+// phone); the reply is the new state as JSON:
+//   http://<panel>/api/exhibit?caption=0        off, remembered (NVS)
+//   http://<panel>/api/exhibit?caption=1        on, remembered
+//   http://<panel>/api/exhibit?caption=default  forget; back to this value
+// A stored choice survives reboots and wireless reflashes; only a full erase
+// (a merged-image flash) clears it.
+#ifndef PF_EXHIBIT_CAPTION
+#define PF_EXHIBIT_CAPTION 1
+#endif
+#ifndef PF_EXHIBIT_CAPTION_MS
+#define PF_EXHIBIT_CAPTION_MS 2500
+#endif
+// 1 = portrait, like every card the device draws (the panel stood on end);
+// 0 = landscape, for a panel hung the long way.
+#ifndef PF_EXHIBIT_CAPTION_ROTATION
+#define PF_EXHIBIT_CAPTION_ROTATION 1
+#endif
+
+// K1-K3: one position per knob, shared by the picture and the sound.
+// Each knob is a position from 0 to 1 that the hand moves by one
+// KNOB_DETENTS-th per detent and that stops at both ends. That position is
+// what every pattern gets (its parameter = the parameter's own low end +
+// position x its range, whichever pattern is up) and, in a build that sets
+// PF_MIDI_OUT_LANE_ABSOLUTE (bundles/exhibit/overrides.h), what the laptop
+// gets as CC 24-26 (round(position x 127)). The positions are the panel's,
+// not a pattern's: a K4 switch keeps them, so the next pattern appears at the
+// same knob positions and the sound does not move.
+//
+// Detents from one end to the other. 32 with the panel's 20-detent encoders
+// is about a turn and a half, which is also what the knob took end to end on
+// the laptop before (4 CC steps per detent).
+//
+// One thing reads raw clicks instead: the core's calibration card (GET
+// /api/display?screen=N). In this build its K1 (screen) and K2 (White Lv)
+// move 1-2 steps per detent, stop at the ends of the position and jump on
+// the frame after a K1-K3 press; set it with /api/display's screen= and
+// level= instead (core_exhibit.h, "What a raw-delta reader sees").
+#ifndef PF_EXHIBIT_KNOB_DETENTS
+#define PF_EXHIBIT_KNOB_DETENTS 32
+#endif
+// Where each knob starts, 0..1: at boot and again at every idle return. Rounded
+// to the nearest detent (0.5 with 32 detents is detent 16, exactly), so a hand
+// can always turn back to it. 0.5 is CC 64 on the laptop. One value per knob
+// for all the patterns: a pattern that should open on another look moves
+// its own range so that the look sits where this position is.
+#ifndef PF_EXHIBIT_KNOB_START_1
+#define PF_EXHIBIT_KNOB_START_1 0.5f
+#endif
+#ifndef PF_EXHIBIT_KNOB_START_2
+#define PF_EXHIBIT_KNOB_START_2 0.5f
+#endif
+#ifndef PF_EXHIBIT_KNOB_START_3
+#define PF_EXHIBIT_KNOB_START_3 0.5f
+#endif
+
+// 1 = K1-K3 presses reach the pattern (several reset a parameter) and go out
+// as MIDI notes 60-62. 0 swallows them too. K4's press is always swallowed:
+// K4 is the pattern switch, and nothing downstream may read it as input.
+#ifndef PF_EXHIBIT_PASS_BUTTONS
+#define PF_EXHIBIT_PASS_BUTTONS 1
+#endif
+
+// ── Footfalls: the panel's own notes ────────────────────────────────────
+//
+// A pattern can flag a moment in the frame it happens in - the gecko's foot
+// touching the ground - and the exhibit sends a MIDI note for it right after
+// that frame is on the panel (exhibit_pulse.h; which pattern, which flag and
+// which notes is the PF_EXHIBIT_PULSE list in exhibit_presets.h). The point
+// is that the sound follows the picture at whatever speed the picture runs:
+// nothing downstream has to guess a tempo, and K3 can be turned mid-show
+// without the footsteps sliding out of step.
+//
+// These are the panel's notes and not a clock: they arrive when they arrive,
+// one per landing, and a DAW should treat them as triggers (a drum rack pad,
+// a sampler), never as a transport.
+//
+// A build whose composition does not name a sink (PF_EXHIBIT_PULSE_SINK, set
+// in bundles/exhibit/features_local.h) compiles none of this.
+
+// The channel the notes go out on, 1..16. 10 by default: the drum channel, so
+// the notes land in a drum rack without fighting the knob CCs and the Program
+// Change, which go out on PF_MIDI_CHANNEL (1 in this build).
+#ifndef PF_EXHIBIT_PULSE_CHANNEL
+#define PF_EXHIBIT_PULSE_CHANNEL 10
+#endif
+
+// The two notes a pattern's row uses by default: one per group of legs, so
+// left and right can carry different samples (or the same one at different
+// tunings). 36 is C1 and 38 is D1 - a General MIDI drum rack's kick and
+// snare pads, which is where a sampler's first two pads sit in Live too.
+#ifndef PF_EXHIBIT_PULSE_NOTE_A
+#define PF_EXHIBIT_PULSE_NOTE_A 36
+#endif
+#ifndef PF_EXHIBIT_PULSE_NOTE_B
+#define PF_EXHIBIT_PULSE_NOTE_B 38
+#endif
+
+// One velocity for every landing: a footstep is an event, not a performance,
+// and a sample that changes loudness step by step reads as a mistake. 1..127.
+#ifndef PF_EXHIBIT_PULSE_VELOCITY
+#define PF_EXHIBIT_PULSE_VELOCITY 100
+#endif
+
+// How long the note is held before its note-off, in ms. Long enough that no
+// host drops it as a zero-length note, short enough that the next landing is
+// never inside it (the fastest the gecko walks is 3.6 landings a second, one
+// every 278 ms). A one-shot sample ignores the note-off entirely; a synth
+// pad would use it, which is why it exists at all.
+#ifndef PF_EXHIBIT_PULSE_MS
+#define PF_EXHIBIT_PULSE_MS 40
+#endif
+
+// After the panel wakes from sleep, K4 turns are ignored for this long, so
+// the turn that woke it does not also switch the pattern.
+#ifndef PF_EXHIBIT_WAKE_GUARD_MS
+#define PF_EXHIBIT_WAKE_GUARD_MS 1000
+#endif
diff --git a/firmware/patternflow/features/exhibit/exhibit_presets.h b/firmware/patternflow/features/exhibit/exhibit_presets.h
new file mode 100644
index 0000000..3da1916
--- /dev/null
+++ b/firmware/patternflow/features/exhibit/exhibit_presets.h
@@ -0,0 +1,298 @@
+// ═══════════════════════════════════════════════════════════
+// PatternFlow - the exhibit's patterns, compiled in
+//
+// The composition points the preset seam here (overrides.h):
+//
+//   #define PF_FEATURE_PRESET_INCLUDE "exhibit/exhibit_presets.h"
+//   #define PF_FEATURE_PRESETS        PF_EXHIBIT_PRESET_ENTRIES
+//
+// so these patterns are appended to presetPatterns[] after the core's own
+// (Origin). Compiled in rather than uploaded as .pfm modules on purpose: a
+// preset switches in the same frame, costs no load, and cannot fail to load
+// in front of a visitor.
+//
+// THREE LISTS, BELOW. PF_EXHIBIT_LIST has one row per pattern: its C++
+// namespace, the artist, the title. The registry entries, the caption table
+// and the count are derived from it, so they cannot drift apart.
+// PF_EXHIBIT_REST_VARS names each pattern's knob variables: what the idle
+// return puts back (core_exhibit.h). PF_EXHIBIT_PULSE names the patterns
+// that flag a moment for the sound to follow (exhibit_pulse.h), and may be
+// empty.
+//
+// Row order is K4 order and it is the Program Change the panel sends. The
+// registry puts Origin at index 0, so the first row is pattern index 1 and
+// sends PC 1, the sixth sends PC 6. Counted the way the Ableton device counts
+// scenes - from 0 at the top - PC 1 fires the SECOND scene from the top; the
+// top scene (0) is Origin, which only the web console can pick. (Live's own
+// scene numbers start at 1, so the top scene is "1" on Live's screen: name
+// the scenes, do not go by that number.) core_exhibit.h derives the range
+// from NUM_PRESETS and checks at boot that these rows really are the last
+// entries of presetPatterns[] - a composition that appended another preset
+// after them would get a serial error and no switching, not the wrong art.
+//
+// The rows are registered HIDDEN (PATTERN_ENTRY_HIDDEN). Hidden means two
+// things to the core that matter here: it does not flash the pattern's NAME
+// in the middle of the panel when a feature switches to it (the caption is
+// the only name a visitor sees), and it does not keep a thumbnail of it. It
+// also means the core's own browsers skip these rows: the K4-hold SELECT
+// screen (locked in this build anyway) and the web console's ← / → buttons
+// (/api/patterns/select?step). Pick an exhibit pattern on the console from
+// the pattern LIST instead; picking by index or name works as usual.
+//
+// ── Swapping in an artist's pattern ─────────────────────────────────────
+//
+//  1. The file. A pattern header is the preset format: one namespace
+//     holding NAME, KNOB_LABELS, ABSOLUTE_READY, setup(), update(dt, input)
+//     and draw() - everything, helpers and tables included, inside that
+//     namespace. The show's headers do NOT live in this clone: they live in
+//     the exhibition repository this clone sits in, one folder per pattern
+//     next to the JavaScript they were translated from,
+//         exhibition_2026/patterns/<n>_<key>/<key>.h
+//     and are included below by a path relative to this file (five levels
+//     up is exhibition_2026/). Editing a pattern is then one commit in that
+//     repository, and the JS and the header cannot drift into two copies.
+//     NOT in presets/: firmware/toolchain/check_presets.py requires every
+//     header there to have a JavaScript twin in web/src/lib/presets/ and
+//     fails without one. Its includes can stay as they are ("config.h",
+//     "src/core_canvas.h", ...): the PlatformIO env puts the sketch folder
+//     on the include path (-I$PROJECT_DIR), so they resolve from any folder.
+//     Keep the author/licence header.
+//
+//  2. The namespace must be unique in the whole image. Exports often carry
+//     a generic one (UntitledPattern, Pattern0510, ...). Before building:
+//         grep -rn "namespace TheName" firmware/patternflow
+//     must find exactly the one file. If not, rename it in that file only -
+//     `namespace UntitledPattern {` -> `namespace ExhibitKimMinji {` - and
+//     use the new name in the rows below. Nothing else refers to it. Pattern
+//     Lab names the namespace after the composition, so two artists who
+//     both kept a default name collide; a unique prefix per artist is the
+//     safe habit.
+//
+//  3. Memory. Every preset's statics live in internal RAM for the life of
+//     the firmware, whether or not it is on screen (src/core_mem.h). A
+//     framebuffer-sized array - `static float trail[128 * 64]` is 32 KB - or
+//     anything else of 1 KB or more must become a pointer allocated once in
+//     setup() through PFMem:
+//         static float* trail = nullptr;
+//         void setup() { if (!trail) trail = PFMem::allocFloats(PANEL_RES_W * PANEL_RES_H); }
+//     and update()/draw() return early while it is null. `static const`
+//     lookup tables are fine: they stay in flash. A plain (non-static)
+//     row-sized scratch array inside draw() lives on the stack and costs
+//     nothing while the pattern is off screen. Every compiled-in pattern's
+//     setup() runs once at boot and never again, so a buffer allocated there
+//     is allocated for all six at once, and a pattern resumes where it was
+//     left rather than starting over when K4 comes back to it. Structs and
+//     2-D tables convert the same way: `static Fish fishes[24]` becomes
+//     `static Fish* fishes` with (Fish*)PFMem::alloc(sizeof(Fish) * 24), and
+//     `static float lut[4][256]` becomes `static float (*lut)[256]`, so every
+//     lut[i][j] in the file stays as it is. Check the file for sizeof(array)
+//     first: on a pointer it is 4, and memset(buf, 0, sizeof(buf)) then
+//     clears four bytes and still compiles. Each conversion made for this
+//     show is marked "exhibit:" in its pattern file.
+//
+//  4. The row: replace the row the new pattern takes over, e.g.
+//         X(ExhibitKimMinji, "KIM MINJI", "Tidal Memory")
+//     Artist and title are drawn with the panel's 1-byte font: plain ASCII
+//     only (anything else prints as '?'). The portrait panel is ten
+//     characters wide: a longer title is word-wrapped onto up to three
+//     lines, an artist onto up to two, and a single word longer than ten
+//     characters falls back to a smaller font. Short reads better. An empty
+//     title ("") shows the pattern's own NAME instead, and an empty artist
+//     ("") draws no artist line, so X(Ns, "", "") captions the NAME alone.
+//
+//  5. The knobs the idle return puts back. In PF_EXHIBIT_REST_VARS, replace
+//     the old pattern's V(...) entries with one per variable the pattern's
+//     update() hands to PFParams::apply / applyInt / applyUnit - usually
+//     four namespace-level globals near the top of the file:
+//         V(ExhibitKimMinji::knob1) V(ExhibitKimMinji::knob2) ...
+//     A struct field works too (V(Ns::params.speed)), and so does an array
+//     element (V(Ns::knobVal[0]) ... for an update() that loops over
+//     knobVal[i]). The values they hold on the first frame, after setup(),
+//     are what comes back; nothing is copied by hand. Leave out clocks
+//     (timeAcc, t): they keep running. If the pattern only recomputes
+//     something when a knob moves, list that too; the same goes for state
+//     a button toggles (a bool, an int) when the next visitor should not
+//     inherit it. A variable declared inside a function cannot be listed.
+//     And ask the artist not to let any K1-K3 end stop the motion or blank
+//     the panel (a speed range starting at 0): between idle returns the next
+//     visitor gets it as the last one left it. (K1-K3's own variables are
+//     overwritten by the knob positions on the next frame anyway - see 6 -
+//     so what the list really puts back is everything else in it.)
+//
+//  6. What the pattern will see. K4 never reaches it: turning K4 switches
+//     patterns, so the pattern's fourth parameter stays at the value its
+//     code starts with - put the look you want there. K1-K3 reach it as the
+//     exhibit's shared knob positions (core_exhibit.h, "K1-K3"), not as
+//     detents: PFParams::apply(input, i, &p, lo, hi, step) for K1-K3 sets
+//     p = lo + (hi - lo) x position on every frame, whatever the step and
+//     whatever value the code starts p at. So a pattern opens on its
+//     parameters at the START positions (PF_EXHIBIT_KNOB_START_n; 0.5 is
+//     the middle of each range), and so does every other pattern: a
+//     pattern that should open on another look moves its lo/hi until that
+//     look sits there. Do not turn a knob round by swapping lo and hi:
+//     PFParams clamps to [lo, hi] as written and pins a swapped range at lo.
+//     Reverse what the parameter means in the pattern's own code instead,
+//     or reverse the DAW's mapping. A pattern that reads input.knobDeltas
+//     or input.knobs itself does not get the position: knobDeltas carries
+//     the core's lane motion (about 1.5 clicks per detent, and a jump on
+//     the frame after a press) and knobs the raw hardware count, so its
+//     picture drifts from CC 24-26 (core_exhibit.h, "What a raw-delta
+//     reader sees"). The host test fails on one; ask for PFParams::apply.
+//     Presses reach it as usual (PF_EXHIBIT_PASS_BUTTONS).
+//
+//  7. Remove the old pattern's #include below once no row names it, then
+//     build and check, from the repository root:
+//         PF_BUILD_DIR=C:/Users/<you>/pfx-exhibit-build ./firmware/bundles/build.sh exhibit
+//         python firmware/toolchain/check_boundaries.py
+//     and, from the exhibition_2026 folder, the host test that lays out
+//     every caption and checks the rest list against the patterns:
+//         python tools/check_exhibit_feature.py
+//     (PF_BUILD_DIR must be a plain-ASCII path: xtensa's linker cannot write
+//     under a folder with non-ASCII characters in its name.) The serial log
+//     at boot prints "[EXHIBIT] 6 patterns at 1..6, default 1 (...)" when
+//     the range checks out.
+//
+// Changing the number of rows is fine; the Ableton side has to agree about
+// which scene each Program Change fires.
+//
+// License: MIT (this file; each pattern keeps its own licence)
+// ═══════════════════════════════════════════════════════════
+#pragma once
+#ifndef PF_EXHIBIT_PRESETS_H
+#define PF_EXHIBIT_PRESETS_H
+
+#include <cstdint>
+
+// The six artists' patterns, one folder each in exhibition_2026/patterns/
+// (step 1). Each header is a C++ translation of the JavaScript beside it
+// (HANYEONGHOE's is generated from its layered project), redone 2026-09-19
+// to replace the first Pattern Lab exports. Each keeps its author and
+// licence header; memory conversions are marked "exhibit:" in the file.
+// The files name the artist (the Title field is the artist's name) and no
+// artwork title yet, so every row below captions the pattern's NAME alone.
+// When a title arrives, fill in both fields - X(YUJIN, "YUJIN", "<title>") -
+// or the caption shows the title and loses the name.
+#include "../../../../../patterns/1_bakwan/bakwan.h"                // BAKWAN
+#include "../../../../../patterns/2_choegyeongeun/choegyeongeun.h"  // CHOEGYEONGEUN
+#include "../../../../../patterns/3_hanyeonghoe/hanyeonghoe.h"      // LabStack_HANYEONGHOE (NAME "HANYEONGHOE")
+#include "../../../../../patterns/4_heoeunbin/heoeunbin.h"          // HEOEUNBIN
+#include "../../../../../patterns/5_jeongeungyo/jeongeungyo.h"      // JEONGEUNGYO
+#include "../../../../../patterns/6_yujin/yujin.h"                  // YUJIN
+
+// X(namespace, "ARTIST", "Title") - one row per pattern, in K4 order.
+// Row 1 is pattern index 1, Program Change 1, and the boot / idle default.
+#define PF_EXHIBIT_LIST(X)            \
+  X(BAKWAN,               "", "")     \
+  X(CHOEGYEONGEUN,        "", "")     \
+  X(LabStack_HANYEONGHOE, "", "")     \
+  X(HEOEUNBIN,            "", "")     \
+  X(JEONGEUNGYO,          "", "")     \
+  X(YUJIN,                "", "")
+
+// V(variable) - every knob variable of every pattern above (step 5 of the
+// swap). Order does not matter; one line per pattern keeps it readable.
+// Besides the knobs, the state a press leaves behind, so the next visitor
+// does not inherit it:
+//   BAKWAN::treeIndex is the tree a K1 press picked (0 = the author's first
+//     tree) and ::showerT the leaf shower's clock (back to its full length:
+//     no shower, no canopy shake). builtIndex stays out on purpose, so a
+//     restored treeIndex that differs from the built tree makes update()
+//     rebuild it in place.
+//   CHOEGYEONGEUN::sceneIndex is the flower scene that closing the doors
+//     (K1) advances; ::canSwitch, ::pressClosing, ::pressPeek and ::pressCool
+//     are a K1 press's close / peek / ignore-window state.
+//   HEOEUNBIN::dir and ::rider are what K1 and K2 presses toggle.
+//   JEONGEUNGYO::pressEnv and ::pressRising are the K1 press envelope.
+//   LabStack_HANYEONGHOE::L1::gust / ::gustTarget and L2::gust / ::gustTarget
+//     are the K1 press gust in the cloud and flower layers.
+//   YUJIN::startleS, ::startleE, ::calmS and ::startleN are the K1 startle.
+//     The per-fish fleeR lives in a PFMem array and cannot be listed; the
+//     pattern reads it only while startleE > 0, and a press overwrites it.
+// Each *Unused / *unused / knobVal[3] entry is the K4 parameter: K4 never
+// reaches a pattern, but it is a PFParams target, so the host test wants it
+// listed. JEONGEUNGYO has no fourth PFParams target.
+#define PF_EXHIBIT_REST_VARS(V)                                                           \
+  V(BAKWAN::foliage) V(BAKWAN::windDir) V(BAKWAN::speed) V(BAKWAN::k4Unused)              \
+  V(BAKWAN::treeIndex) V(BAKWAN::showerT)                                                 \
+  V(CHOEGYEONGEUN::knobDoorOpen) V(CHOEGYEONGEUN::knobZoom)                               \
+  V(CHOEGYEONGEUN::knobFlowerSpeed) V(CHOEGYEONGEUN::knobUnused)                          \
+  V(CHOEGYEONGEUN::sceneIndex) V(CHOEGYEONGEUN::canSwitch)                                \
+  V(CHOEGYEONGEUN::pressClosing) V(CHOEGYEONGEUN::pressPeek)                              \
+  V(CHOEGYEONGEUN::pressCool)                                                             \
+  V(LabStack_HANYEONGHOE::knobVal[0]) V(LabStack_HANYEONGHOE::knobVal[1])                 \
+  V(LabStack_HANYEONGHOE::knobVal[2]) V(LabStack_HANYEONGHOE::knobVal[3])                 \
+  V(LabStack_HANYEONGHOE::L1::gustTarget) V(LabStack_HANYEONGHOE::L1::gust)               \
+  V(LabStack_HANYEONGHOE::L2::gustTarget) V(LabStack_HANYEONGHOE::L2::gust)               \
+  V(HEOEUNBIN::sizeVal) V(HEOEUNBIN::backdropVal)                                         \
+  V(HEOEUNBIN::speedVal) V(HEOEUNBIN::unusedVal)                                          \
+  V(HEOEUNBIN::dir) V(HEOEUNBIN::rider)                                                   \
+  V(JEONGEUNGYO::paramState) V(JEONGEUNGYO::paramRotation)                                \
+  V(JEONGEUNGYO::paramDriftSpeed)                                                         \
+  V(JEONGEUNGYO::pressEnv) V(JEONGEUNGYO::pressRising)                                    \
+  V(YUJIN::param_fishCount) V(YUJIN::param_currentLoop)                                   \
+  V(YUJIN::param_swimSpeed) V(YUJIN::param_unused)                                        \
+  V(YUJIN::startleS) V(YUJIN::startleE) V(YUJIN::calmS) V(YUJIN::startleN)
+
+// P(namespace, flag, note for bit 1, note for bit 2) - the patterns that mark
+// a moment in the frame it happens in. The flag is a variable the pattern's
+// update() ORs bits into and nothing else; exhibit_pulse.h reads it after the
+// frame that pattern drew, clears it, and sends a note for each bit set. A
+// pattern that marks nothing has no row, and this list may be empty.
+//
+// HEOEUNBIN::stepPulse is the gecko's footfalls: bit 1 is the near front and
+// far hind legs, bit 2 the other pair, each raised in the frame that pair's
+// feet touch down. They alternate, and they come 3 x Speed times a second
+// (Speed is K3, 0.2..1.2), so the room hears the walk it is watching however
+// the knob is turned.
+//
+// The notes and the channel they go out on are PF_EXHIBIT_PULSE_* in
+// exhibit_config.h; a row may name any note, so two patterns can share a
+// sample or take a pad each.
+#define PF_EXHIBIT_PULSE(P)                                                               \
+  P(HEOEUNBIN, HEOEUNBIN::stepPulse, PF_EXHIBIT_PULSE_NOTE_A, PF_EXHIBIT_PULSE_NOTE_B)
+
+// ── Derived from the lists: nothing below needs editing ─────────────────
+
+// Registry entries, trailing comma on each - they expand inside
+// presetPatterns[] in pattern_registry.h, where PATTERN_ENTRY_HIDDEN is
+// defined. Hidden: see the header comment.
+#define PF_EXHIBIT_AS_ENTRY_(ns, artist, title) PATTERN_ENTRY_HIDDEN(ns),
+#define PF_EXHIBIT_PRESET_ENTRIES PF_EXHIBIT_LIST(PF_EXHIBIT_AS_ENTRY_)
+
+// A preprocessor-usable count: (0 +1 +1 ...).
+#define PF_EXHIBIT_COUNT_ONE_(ns, artist, title) +1
+#define PF_EXHIBIT_PATTERN_COUNT (0 PF_EXHIBIT_LIST(PF_EXHIBIT_COUNT_ONE_))
+
+namespace PFExhibitPresets {
+
+struct Caption {
+  const char* artist;
+  const char* title;     // "" = the pattern's own NAME
+  void (*setup)();       // identifies the registry row at boot (core_exhibit.h)
+};
+
+#define PF_EXHIBIT_AS_CAPTION_(ns, artist, title) {artist, title, ns::setup},
+inline const Caption CAPTIONS[] = {PF_EXHIBIT_LIST(PF_EXHIBIT_AS_CAPTION_)};
+
+constexpr int COUNT = PF_EXHIBIT_PATTERN_COUNT;
+
+// The rest list as addresses and sizes. A knob is a float, an int or a bool;
+// anything larger than 8 bytes is not a knob and is refused at compile time,
+// and so is a const (the cast below will not drop it).
+constexpr int REST_VAR_BYTES = 8;
+struct RestVar {
+  void* addr;
+  uint8_t size;
+};
+#define PF_EXHIBIT_REST_CHECK_(var) \
+  static_assert(sizeof(var) <= REST_VAR_BYTES, "PF_EXHIBIT_REST_VARS: " #var " is not a knob value (over 8 bytes)");
+PF_EXHIBIT_REST_VARS(PF_EXHIBIT_REST_CHECK_)
+#define PF_EXHIBIT_AS_REST_(var) {static_cast<void*>(&(var)), (uint8_t)sizeof(var)},
+// The last row is a terminator, so an empty list still compiles.
+inline const RestVar REST_VARS[] = {PF_EXHIBIT_REST_VARS(PF_EXHIBIT_AS_REST_){nullptr, 0}};
+constexpr int REST_SLOTS = (int)(sizeof(REST_VARS) / sizeof(REST_VARS[0]));
+constexpr int REST_COUNT = REST_SLOTS - 1;
+
