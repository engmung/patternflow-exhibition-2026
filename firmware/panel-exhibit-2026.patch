diff --git a/firmware/patternflow/features/midi/midi_sessions.h b/firmware/patternflow/features/midi/midi_sessions.h
new file mode 100644
index 0000000..87a7799
--- /dev/null
+++ b/firmware/patternflow/features/midi/midi_sessions.h
@@ -0,0 +1,278 @@
+// The RTP-MIDI hosts that have a session up, one entry per SSRC, so a session
+// counts once however many times the library reports it.
+//
+// Why a set and not a counter. AppleMIDI 3.5.0 can report one session's start
+// twice, and reports its end once:
+//  - As initiator it re-sends the data-port invitation every second until an
+//    OK comes back. A host slow enough to answer two of them sends two OKs,
+//    and ReceivedDataInvitationAccepted() sets a participant that is already
+//    Connected back to DataInvitationAccepted - so the next
+//    manageSessionInvites() calls the connected handler for it again.
+//  - As listener, a data invitation the host re-sends reaches
+//    ReceivedDataInvitation() for a participant it already has, which accepts
+//    it again and calls the connected handler again.
+// The counter this replaces went up once per report. After the one end it sat
+// at 1 with nobody there, and inviteIfDue() invites only at zero: the panel
+// never dialled its host again, and MIDI stayed dead until a reboot.
+//
+// What an SSRC names. One end of a session has one SSRC for all its sessions,
+// so an SSRC names a HOST, not one of the library's participants. The library
+// can hold two participants with the same SSRC (a host invites the panel while
+// the panel's own invitation to it is still open: that participant has SSRC 0
+// until its control OK, and nothing de-duplicates at that point), both report
+// joining, and each end is reported once. The set counts that host once, so
+// the first end takes it off while the other session is still up. That is why
+// the count is only status and the "invite now?" test, and never gates output:
+// core_midi_rtp.h's sink() leaves "is anybody there" to the library, which
+// refuses to send when no participant can receive.
+//
+// Ends that were never sessions. An invitation the library gives up on (13
+// unanswered attempts unless the build asks for fewer, in
+// manageSessionInvites) is ended through sendEndSession(), which calls the
+// disconnect handler with whatever SSRC the participant had: 0 if the host
+// never answered, the HOST's own SSRC if only
+// the data half went unanswered - the same SSRC as a live session with that
+// host, if there is one. The set cannot tell those apart, so RtpSessions below
+// is told: the library raises NoResponseFromConnectionRequestException
+// immediately before that end, in the same call, and the end that follows is
+// not taken off the count whatever SSRC it carries.
+//
+// Ends that were refused. A NO erases the invitation it names in
+// ReceivedInvitationRejected() without calling the disconnect handler at all.
+// A build with PF_MIDI_REINVITE_ON_REJECTION reports it (core_midi_rtp.h
+// copies that one member): an invitation not yet reported connected is
+// announced as refused, and the end that follows is taken like a give-up,
+// except that the host did answer; a NO naming a session that is up ends it
+// like a BY.
+//
+// Sized to the library's participant limit, so it can only fill if the
+// library dropped a session without calling the disconnect handler (the NO
+// above, in every other build). A new SSRC arriving at a full set is
+// therefore proof that an entry is stale; the oldest goes, because the
+// arrival is certainly alive.
+//
+// No locking: one task owns it, the one that runs the session. See
+// core_midi_rtp.h for which task that is and how the size is published.
+//
+// License: MIT
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace PatternflowMidiTransport {
+
+template<size_t Capacity> class SessionSet {
+  static_assert(Capacity > 0, "at least one session");
+  uint32_t ssrcs[Capacity]{};   // oldest first
+  size_t count = 0;
+
+public:
+  enum class Join : uint8_t {
+    Added,           // a session that was not up
+    Already,         // a repeated report of one that is: not an arrival
+    ReplacedOldest,  // was full: the oldest entry was stale and is gone
+  };
+
+  bool contains(uint32_t ssrc) const {
+    for (size_t i = 0; i < count; ++i)
+      if (ssrcs[i] == ssrc) return true;
+    return false;
+  }
+
+  Join join(uint32_t ssrc) {
+    if (contains(ssrc)) return Join::Already;
+    if (count < Capacity) {
+      ssrcs[count++] = ssrc;
+      return Join::Added;
+    }
+    for (size_t i = 1; i < Capacity; ++i) ssrcs[i - 1] = ssrcs[i];
+    ssrcs[Capacity - 1] = ssrc;
+    return Join::ReplacedOldest;
+  }
+
+  // True if the SSRC was up and is now gone.
+  bool leave(uint32_t ssrc) {
+    for (size_t i = 0; i < count; ++i) {
+      if (ssrcs[i] != ssrc) continue;
+      for (size_t j = i + 1; j < count; ++j) ssrcs[j - 1] = ssrcs[j];
+      ssrcs[--count] = 0;
+      return true;
+    }
+    return false;
+  }
+
+  size_t size() const { return count; }
+};
+
+// What one disconnect report turned out to be.
+enum class End : uint8_t {
+  Session,             // a host that had joined: it is off the count
+  NeverJoined,         // no session with this SSRC was counted: nothing comes off
+  InvitationGivenUp,   // the library stopped inviting: not a session, whatever SSRC
+  InvitationRejected,  // the host said NO: not a session either, but an answer
+};
+
+// Everything the RTP handlers and inviteIfDue() decide, apart from the socket,
+// so the host test can play the library's call sequences against it.
+template<size_t Capacity, uint32_t OpenMs = 30000> class RtpSessions {
+  SessionSet<Capacity> up;
+  bool givenUpNext = false;    // set by the exception, consumed by the end
+  bool rejectedNext = false;   // ...and with it by a NO: that end is a refusal
+  uint32_t openAddress = 0;    // host of the invitation the library may still be trying; 0 = none
+  uint32_t openSinceMs = 0;
+
+public:
+  using Join = typename SessionSet<Capacity>::Join;
+
+  // How long the library can keep one invitation open: 13 control attempts a
+  // little over a second apart (~13 s), and if the control OK arrives just
+  // before the last, 13 data attempts after it (~26 s). A second invitation to
+  // the same host inside that window can leave two participants with the
+  // host's SSRC (a host that takes the new token as a restart still answers
+  // the old one's data invitation by SSRC): every message goes out twice, the
+  // host's clock-sync replies are matched to the first of the two, and the
+  // other one's give-up later ends the host's side of both. The margin covers
+  // a frame-polled transport at ~10 fps; core_midi_rtp.h checks it against the
+  // library's attempt count, and passes a shorter window when a build gives
+  // the library fewer attempts (PF_MIDI_INVITE_ATTEMPTS). Read from the
+  // library source, not seen on a panel.
+  static constexpr uint32_t INVITATION_OPEN_MS = OpenMs;
+
+  Join joined(uint32_t ssrc) { return up.join(ssrc); }
+
+  // NoResponseFromConnectionRequestException: the very next end report is
+  // the invitation being given up.
+  void invitationGivenUp() { givenUpNext = true; rejectedNext = false; }
+  // A NO for an invitation (PF_MIDI_REINVITE_ON_REJECTION): the very next end
+  // report is that invitation, refused. Over like one given up - off the
+  // count whatever SSRC it carries, and no longer open.
+  void invitationRejected() { givenUpNext = true; rejectedNext = true; }
+
+  End ended(uint32_t ssrc) {
+    if (givenUpNext) {
+      const bool rejected = rejectedNext;
+      givenUpNext = false;
+      rejectedNext = false;
+      openAddress = 0;
+      return rejected ? End::InvitationRejected : End::InvitationGivenUp;
+    }
+    return up.leave(ssrc) ? End::Session : End::NeverJoined;
+  }
+
+  // Held notes are attributed by SSRC (ReceivedRtp looks the participant up by
+  // it), so any end that carries a host's SSRC may have taken a pressed key
+  // with it - including an invitation given up after its control OK, whose
+  // host may already have sent MIDI. Only SSRC 0, an invitation nobody ever
+  // answered, cannot have.
+  static bool endClearsNotes(End end, uint32_t ssrc) {
+    return end == End::Session || ssrc != 0;
+  }
+
+  // The invite clock. core_midi_rtp.h keeps it in one atomic word, because
+  // setHost() restarts it from another task: the millis() of the last
+  // invitation, or 0 for "at once". inviteIfDue() invites when it is due.
+  static bool inviteDue(uint32_t lastMs, uint32_t atMs, uint32_t periodMs) {
+    return lastMs == 0 || (uint32_t)(atMs - lastMs) >= periodMs;
+  }
+  // The clock value that makes the next invitation due firstDelayMs after
+  // atMs: periodMs minus the delay in the past, wrapping as millis() does.
+  // Never 0, which would read as "at once": that one instant is a
+  // millisecond later instead.
+  static uint32_t clockDueIn(uint32_t atMs, uint32_t periodMs, uint32_t firstDelayMs) {
+    const uint32_t last = atMs - (periodMs - firstDelayMs);
+    return last ? last : 1;
+  }
+
+  // False while an invitation to this host may still be open in the library.
+  bool mayInvite(uint32_t address, uint32_t atMs) const {
+    return !(openAddress != 0 && openAddress == address &&
+             (uint32_t)(atMs - openSinceMs) < INVITATION_OPEN_MS);
+  }
+  void invited(uint32_t address, uint32_t atMs) {
+    openAddress = address;
+    openSinceMs = atMs;
+  }
+
+  // The library's own sendEndSession() (no argument) has just ended and erased
+  // every participant, so nothing is up and no invitation is open whatever the
+  // reports said: an entry the library dropped without one goes too, and a late
+  // answer to the last invitation finds no participant to land on, so the next
+  // invitation to that host cannot become a second one. Only for that call - an
+  // end reported one participant at a time is ended() above.
+  void allEnded() {
+    up = SessionSet<Capacity>();
+    givenUpNext = false;
+    rejectedNext = false;
+    openAddress = 0;
+  }
+
+  bool contains(uint32_t ssrc) const { return up.contains(ssrc); }
+  size_t size() const { return up.size(); }
+};
+
+// The Wi-Fi self-heal's bookkeeping (core_midi_rtp.h, PF_MIDI_WIFI_HEAL_MS).
+// "Quiet" is a link that is up with no session on it: it starts when the link
+// comes up, when the last session ends, and again after each heal and after
+// each NO the host answers an invitation with, and a join ends it.
+// Invitations given up are counted only while quiet and while the link is
+// up - one given up on a link that is down says nothing of the host. A
+// heal is due once a quiet spell has lasted afterMs with at least
+// MIN_UNANSWERED invitations given up in it - the host was asked, repeatedly,
+// and never answered on a link that says it is fine - and never sooner than
+// gapMs after the last one. Owned by the session's task, like RtpSessions.
+class LinkWatch {
+  bool linkIsUp = false;
+  bool quiet = false;
+  uint32_t quietSinceMs = 0;
+  uint32_t unanswered = 0;
+  bool healedBefore = false;
+  uint32_t lastHealMs = 0;
+
+public:
+  static constexpr uint32_t MIN_UNANSWERED = 2;
+
+  void linkUp(uint32_t atMs) { linkIsUp = true; quiet = true; quietSinceMs = atMs; unanswered = 0; }
+  // The link as the session's task reads it, on every pass. Coming back up
+  // starts the spell over there and then - however long it was down, and
+  // whatever ended meanwhile - rather than when the frame task gets to the
+  // connect edge, which can be a frame or more later: a spell carried over
+  // from before the drop would make a heal due on the link that has just come
+  // back.
+  void link(bool upNow, uint32_t atMs) {
+    if (upNow == linkIsUp) return;
+    if (upNow) linkUp(atMs);
+    else linkIsUp = false;
+  }
+  void sessionUp() { quiet = false; unanswered = 0; }
+  // The last session ended; a quiet spell already running keeps its start.
+  void sessionsDown(uint32_t atMs) {
+    if (quiet) return;
+    quiet = true; quietSinceMs = atMs; unanswered = 0;
+  }
+  void invitationUnanswered() { if (quiet && linkIsUp) ++unanswered; }
+  // The host answered an invitation, if only to refuse it (a NO,
+  // PF_MIDI_REINVITE_ON_REJECTION): the link carried packets both ways just
+  // now, so what went unanswered before says nothing against it. A quiet
+  // spell starts over from here, as it does when the link comes up.
+  void hostAnswered(uint32_t atMs) {
+    unanswered = 0;
+    if (quiet) quietSinceMs = atMs;
+  }
+
+  bool healDue(uint32_t atMs, uint32_t afterMs, uint32_t gapMs) const {
+    return quiet && linkIsUp && unanswered >= MIN_UNANSWERED &&
+           (uint32_t)(atMs - quietSinceMs) >= afterMs &&
+           (!healedBefore || (uint32_t)(atMs - lastHealMs) >= gapMs);
+  }
+  // The reconnect was asked for. Whatever the link does next, the count starts
+  // over: a reconnect that never drops the link waits a whole spell again.
+  void healed(uint32_t atMs) {
+    healedBefore = true; lastHealMs = atMs;
+    quiet = true; quietSinceMs = atMs; unanswered = 0;
+  }
+
+  uint32_t unansweredCount() const { return unanswered; }
+  uint32_t quietForMs(uint32_t atMs) const { return quiet ? atMs - quietSinceMs : 0; }
+};
+
+}  // namespace PatternflowMidiTransport
