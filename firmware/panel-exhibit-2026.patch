+    // millis() wrapping inside the window.
+    rtp.invited(hostIp, 0xFFFFF000u);
+    assert(!rtp.mayInvite(hostIp, 0x00001000u));
+    assert(rtp.mayInvite(hostIp, 0xFFFFF000u + life));
+
+    // The invite clock inviteIfDue() reads: due once the period has passed
+    // since the last invitation, at once for 0 (setHost()).
+    const uint32_t period = 20000;   // core_midi_rtp.h's REINVITE_MS
+    assert(Rtp::inviteDue(0, 5, period));
+    assert(!Rtp::inviteDue(1000, 1000 + period - 1, period) && Rtp::inviteDue(1000, 1000 + period, period));
+    // begin() with the default first delay, the whole period: the clock is
+    // simply "now", as it was before the delay was a setting.
+    assert(Rtp::clockDueIn(4000, period, period) == 4000);
+    // PF_MIDI_FIRST_INVITE_DELAY_MS 1000: due 1 s after the network came up,
+    // wherever millis() stands - early in boot (the clock goes below zero),
+    // at the instant that would make it 0 ("at once"), and across the wrap.
+    for (uint32_t at : {1200u, 5000u, 19000u, 0xFFFFFF00u, 0u}) {
+      const uint32_t started = Rtp::clockDueIn(at, period, 1000);
+      assert(started != 0);
+      assert(!Rtp::inviteDue(started, at, period) && !Rtp::inviteDue(started, at + 999, period));
+      assert(Rtp::inviteDue(started, at + 1001, period));
+    }
+
+    // PF_MIDI_REINVITE_ON_REJOIN. The session came from an invitation at
+    // 100 s; the Wi-Fi drops at 110 s (the host's box rebooting) and is back
+    // at 112 s. core_midi_rtp.h calls the library's sendEndSession(), which
+    // reports each participant's end one by one, then allEnded().
+    Rtp rejoin;
+    rejoin.invited(hostIp, 100000);
+    assert(rejoin.joined(flowLocal) == Join::Added);
+    assert(rejoin.joined(stranger) == Join::Added);   // one the library dropped without a report
+    assert(!rejoin.mayInvite(hostIp, 112000));        // the window from 100 s still holds
+    assert(rejoin.ended(flowLocal) == End::Session);  // sendEndSession()'s report
+    assert(rejoin.size() == 1);                       // the stale entry would keep inviteIfDue() away
+    rejoin.invitationGivenUp();                       // (a latch left set is not carried over either)
+    rejoin.allEnded();
+    assert(rejoin.size() == 0 && !rejoin.contains(stranger));
+    // No participant is left in the library, so the invitation at 100 s cannot
+    // answer into a second session: the next one goes when the clock says.
+    const uint32_t started = Rtp::clockDueIn(112000, period, 1000);
+    assert(!Rtp::inviteDue(started, 112500, period));
+    assert(Rtp::inviteDue(started, 113001, period) && rejoin.mayInvite(hostIp, 113001));
+    assert(rejoin.ended(0) == End::NeverJoined);
+    // ...and that invitation is guarded like any other.
+    rejoin.invited(hostIp, 113001);
+    assert(!rejoin.mayInvite(hostIp, 113001 + life - 1) && rejoin.mayInvite(hostIp, 113001 + life));
+
+    // PF_MIDI_INVITE_ATTEMPTS 3 with PF_MIDI_REINVITE_AFTER_END_MS 1000, as
+    // the exhibit builds it. The window core_midi_rtp.h passes for 3 attempts:
+    // 2 x 1 s x (3 + 1) + 2 s, still over the library's worst case (a late
+    // control OK, then 3 data attempts: ~6 s).
+    using Short = RtpSessions<2, 2u * 1000u * (3u + 1u) + 2000u>;
+    static_assert(Short::INVITATION_OPEN_MS == 10000 && Short::INVITATION_OPEN_MS > 2u * 1000u * (3u + 1u),
+                  "the exhibit's window");
+    Short fast;
+    // FlowLocal's one OK is lost: its repeats of the same token are ignored,
+    // the library gives up ~3 s later, and the next invitation - a new token -
+    // is due 1 s after that. The give-up cleared the guard, so it may go.
+    fast.invited(hostIp, 5000);
+    assert(!fast.mayInvite(hostIp, 7000));
+    fast.invitationGivenUp();
+    assert(fast.ended(0) == End::InvitationGivenUp && fast.size() == 0);
+    const uint32_t retry = Short::clockDueIn(8000, period, 1000);
+    assert(!Short::inviteDue(retry, 8999, period) && Short::inviteDue(retry, 9001, period));
+    assert(fast.mayInvite(hostIp, 9001));
+    // An invitation that ends without a report (a NO, where the library's
+    // ReceivedInvitationRejected() erases it silently) is held for the
+    // shorter window only.
+    fast.invited(hostIp, 9001);
+    assert(!fast.mayInvite(hostIp, 9001 + 9999) && fast.mayInvite(hostIp, 9001 + 10000));
+    // A session that FlowLocal ends (the laptop monitor's reconnect sends a
+    // BY) 5 s after the invitation that made it: the guard from that
+    // invitation would hold the next one for another 5 s, so core_midi_rtp.h
+    // clears the library first (restartSessions() -> allEnded()) and invites
+    // 1 s later.
+    fast.invited(hostIp, 30000);
+    assert(fast.joined(flowLocal) == Join::Added);
+    assert(fast.ended(flowLocal) == End::Session && fast.size() == 0);
+    assert(!fast.mayInvite(hostIp, 35000));
+    fast.allEnded();
+    const uint32_t again = Short::clockDueIn(35000, period, 1000);
+    assert(Short::inviteDue(again, 36001, period) && fast.mayInvite(hostIp, 36001));
+
+    // PF_MIDI_REINVITE_ON_REJECTION, as the exhibit builds it. FlowLocal
+    // refuses an invitation with a NO. core_midi_rtp.h's copy of
+    // ReceivedInvitationRejected() erases it, announces the refusal and reports
+    // the end with whatever SSRC it had: 0 while the control half was open.
+    // Over like a give-up - nothing comes off the count, the guard lets the
+    // next one go at once - and that one is due 1 s later. Before this the NO
+    // said nothing: the guard held the host for the window, the re-invite
+    // period for 20 s - the 20-24 s sessions of 2026-09-27.
+    const uint32_t exhibitPeriod = EXHIBIT_PF_MIDI_REINVITE_MS;
+    Short refused;
+    refused.invited(hostIp, 40000);
+    assert(!refused.mayInvite(hostIp, 40030));
+    refused.invitationRejected();
+    assert(refused.ended(0) == End::InvitationRejected && refused.size() == 0);
+    assert(!Short::endClearsNotes(End::InvitationRejected, 0));   // nobody's key came through
+    assert(refused.mayInvite(hostIp, 40030));
+    const uint32_t afterNo = Short::clockDueIn(40030, exhibitPeriod, 1000);
+    assert(!Short::inviteDue(afterNo, 41029, exhibitPeriod) && Short::inviteDue(afterNo, 41030, exhibitPeriod));
+    // A NO for the data half, after the control OK gave the invitation
+    // FlowLocal's SSRC: the same, and a key held through it is released.
+    refused.invited(hostIp, 50000);
+    refused.invitationRejected();
+    assert(refused.ended(flowLocal) == End::InvitationRejected && refused.size() == 0);
+    assert(Short::endClearsNotes(End::InvitationRejected, flowLocal));
+    assert(refused.mayInvite(hostIp, 50001));
+    // The latch is spent: the next end is read as usual, a join as a join.
+    assert(refused.joined(flowLocal) == Join::Added);
+    assert(refused.ended(flowLocal) == End::Session && refused.size() == 0);
+    // Announced while a session with that host is up (the exhibit never
+    // invites then; another build could): the session stays counted, as with
+    // a give-up, and its own end comes off later.
+    assert(refused.joined(flowLocal) == Join::Added);
+    refused.invitationRejected();
+    assert(refused.ended(flowLocal) == End::InvitationRejected && refused.size() == 1);
+    assert(refused.ended(flowLocal) == End::Session && refused.size() == 0);
+    // A give-up announced after a refusal that was never reported is a
+    // give-up, and allEnded() forgets an announcement nothing consumed.
+    refused.invitationRejected();
+    refused.invitationGivenUp();
+    assert(refused.ended(0) == End::InvitationGivenUp);
+    refused.invitationRejected();
+    refused.allEnded();
+    assert(refused.ended(0) == End::NeverJoined);
+    // A BY for the invitation before it joined (after its control OK it
+    // carries FlowLocal's SSRC; a BY FlowLocal sends then - for the session
+    // this one replaces, to an SSRC it does not know - erases it in the
+    // library). The end comes through as nothing that joined: alone it
+    // schedules nothing and the guard still holds the host, so with
+    // PF_MIDI_REINVITE_ON_REJECTION core_midi_rtp.h restarts - allEnded(), and
+    // the next invitation 1 s later instead of 10 s (the window) or 20 s.
+    Short byEarly;
+    byEarly.invited(hostIp, 60000);
+    assert(byEarly.ended(flowLocal) == End::NeverJoined && byEarly.size() == 0);
+    assert(!byEarly.mayInvite(hostIp, 60000 + Short::INVITATION_OPEN_MS - 1));
+    byEarly.allEnded();
+    const uint32_t afterBy = Short::clockDueIn(60050, exhibitPeriod, 1000);
+    assert(Short::inviteDue(afterBy, 61050, exhibitPeriod) && byEarly.mayInvite(hostIp, 61050));
+    // PF_MIDI_REINVITE_MS: an end nothing reports at all waits for the period
+    // AND the guard - never less than the window after the last invitation,
+    // so a shorter period cannot open a second invitation; with the exhibit's
+    // 3 s that is the window (10 s) instead of 20 s.
+    Short silent;
+    silent.invited(hostIp, 70000);
+    uint32_t next = 70000;
+    while (!(Short::inviteDue(70000, next, exhibitPeriod) && silent.mayInvite(hostIp, next))) ++next;
+    assert(next == 70000 + Short::INVITATION_OPEN_MS);
+    next = 70000;
+    while (!(Short::inviteDue(70000, next, period) && silent.mayInvite(hostIp, next))) ++next;
+    assert(next == 70000 + period);   // as it was: the 20 s period
+  }
+
+  // The guard as a property (guardHolds() above): 50 random runs of 30
+  // simulated minutes each for three compositions - every published edition
+  // (20 s period, 13 attempts, 30 s window, ends left to the period), the
+  // exhibit as it was built on 2026-09-25 (3 attempts, 1 s after an end, a
+  // 10 s window, the 20 s period), and the exhibit now (its own numbers).
+  {
+    constexpr uint32_t exAttempts = EXHIBIT_PF_MIDI_INVITE_ATTEMPTS;
+    constexpr uint32_t exWindow = 2u * 1000u * (exAttempts + 1u) + 2000u;   // core_midi_rtp.h's formula
+    const RtpKnobs editions{20000, 20000, 0, 13, false};
+    const RtpKnobs exhibitBefore{20000, 1000, 1000, 3, false};
+    const RtpKnobs exhibitNow{EXHIBIT_PF_MIDI_REINVITE_MS, EXHIBIT_PF_MIDI_FIRST_INVITE_DELAY_MS,
+                              EXHIBIT_PF_MIDI_REINVITE_AFTER_END_MS, exAttempts,
+                              EXHIBIT_PF_MIDI_REINVITE_ON_REJECTION != 0};
+    GuardRun a, b, c;
+    for (uint32_t seed = 1; seed <= 50; ++seed) {
+      const GuardRun ra = guardHolds<30000>(editions, seed, 30u * 60u * 1000u);
+      const GuardRun rb = guardHolds<10000>(exhibitBefore, seed, 30u * 60u * 1000u);
+      const GuardRun rc = guardHolds<exWindow>(exhibitNow, seed, 30u * 60u * 1000u);
+      for (auto [sum, one] : {std::pair<GuardRun*, const GuardRun*>{&a, &ra}, {&b, &rb}, {&c, &rc}}) {
+        sum->invites += one->invites; sum->joins += one->joins; sum->silentEnds += one->silentEnds;
+        sum->worstAfterReported = std::max(sum->worstAfterReported, one->worstAfterReported);
+        sum->worstAfterSilent = std::max(sum->worstAfterSilent, one->worstAfterSilent);
+        sum->longestOpen = std::max(sum->longestOpen, one->longestOpen);
+      }
+    }
+    // The model reached the library's worst case: a control OK just before the
+    // control give-up, then the whole data half - under each window.
+    assert(a.longestOpen > 25000 && a.longestOpen < 30000);
+    assert(b.longestOpen > 5500 && b.longestOpen < 10000);
+    assert(c.longestOpen > 5500 && c.longestOpen < exWindow);
+    assert(a.joins > 500 && b.joins > 1000 && c.joins > 1000);
+    // Every published edition, as before: a NO nothing reports holds the host
+    // for the whole 30 s window.
+    assert(a.silentEnds > 0 && a.worstAfterSilent <= 30000 + 1 && a.worstAfterSilent >= 29000);
+    // The exhibit of 2026-09-25: the NO cost the 20 s period.
+    assert(b.silentEnds > 0 && b.worstAfterSilent <= 20000 + 1 && b.worstAfterSilent >= 19000);
+    assert(b.worstAfterReported > 5000);   // and a BY before the join: the window, or the period
+    // The exhibit now: every end is reported, and after every one - given up,
+    // refused, ended by a BY before it joined, a session's end - the host is
+    // invited again 1 s later (a restart takes one pass more).
+    assert(c.silentEnds == 0);
+    assert(c.worstAfterReported <= EXHIBIT_PF_MIDI_REINVITE_AFTER_END_MS + 2);
+    printf("rtp guard: never two invitations open to one host in %u + %u + %u invitations; "
+           "after an end the next goes within %u ms (exhibit), %u / %u ms after a NO nothing reported (2026-09-25 / editions)\n",
+           (unsigned)a.invites, (unsigned)b.invites, (unsigned)c.invites, (unsigned)c.worstAfterReported,
+           (unsigned)b.worstAfterSilent, (unsigned)a.worstAfterSilent);
+  }
+
+  // The exhibit's clock-sync and self-heal numbers, as its overrides.h sets
+  // them. A host that stops answering is let go HEARTBEAT + UNANSWERED x RETRY
+  // after its last answer (core_midi_rtp.h): wanted within 10-15 s. A clock
+  // sync at least every 8 s, so a session stays well inside the 25 s FlowLocal
+  // gives a silent one, and at least 4 exchanges lost in a row before a live
+  // session is dropped. The self-heal's spell must hold two whole invitations
+  // given up and the pause after each, or it could never be due.
+  {
+    constexpr uint32_t heartbeat = EXHIBIT_PF_MIDI_SYNC_HEARTBEAT_MS, retry = EXHIBIT_PF_MIDI_SYNC_RETRY_MS;
+    constexpr uint32_t unanswered = EXHIBIT_PF_MIDI_SYNC_UNANSWERED, heal = EXHIBIT_PF_MIDI_WIFI_HEAL_MS;
+    constexpr uint32_t attempts = EXHIBIT_PF_MIDI_INVITE_ATTEMPTS, afterEnd = EXHIBIT_PF_MIDI_REINVITE_AFTER_END_MS;
+    constexpr uint32_t letGo = heartbeat + unanswered * retry;
+    static_assert(letGo >= 10000 && letGo <= 15000, "the exhibit lets a silent host go within 10-15 s");
+    static_assert(heartbeat >= 1000 && heartbeat <= 8000, "a clock sync at least every 8 s");
+    static_assert(letGo < 25000, "a session FlowLocal still counts is let go before it times out itself");
+    static_assert(unanswered >= 4 && retry >= 500, "a lossy link must lose several exchanges in a row");
+    static_assert(heal >= 2u * ((attempts + 1u) * 1001u + afterEnd), "the heal's spell holds two give-ups");
+    static_assert(EXHIBIT_PF_MIDI_REINVITE_ON_REJECTION == 1 && EXHIBIT_PF_MIDI_REINVITE_MS <= 5000,
+                  "the exhibit reports a NO, and a silent end waits seconds, not 20 s");
+    printf("exhibit rtp: a silent host let go %u ms after its last answer (clock sync every %u ms, %u unanswered %u ms apart), "
+           "self-heal after %u ms\n",
+           (unsigned)letGo, (unsigned)heartbeat, (unsigned)unanswered, (unsigned)retry, (unsigned)heal);
+  }
+
+  // The Wi-Fi self-heal's bookkeeping (LinkWatch), with a 60 s spell and a
+  // 2 min gap - the exhibit's first numbers; its own are checked above.
+  {
+    const uint32_t after = 60000, gap = 120000;
+    LinkWatch w;
+    // Before the link was ever up nothing is due, whatever went unanswered.
+    w.invitationUnanswered(); w.invitationUnanswered();
+    assert(!w.healDue(100000, after, gap));
+    // The link comes up at 2 s; every invitation goes unanswered, one given
+    // up every ~4 s. Due at 62 s, not before, and only on a link that is up.
+    w.linkUp(2000);
+    w.link(true, 2002);   // pump()'s first read: the link begin() started on, not an edge
+    for (uint32_t t = 6000; t <= 58000; t += 4000) w.invitationUnanswered();
+    assert(w.unansweredCount() == 14);
+    assert(!w.healDue(61999, after, gap));
+    assert(w.healDue(62000, after, gap));
+    LinkWatch dropped = w;
+    dropped.link(false, 62000);
+    assert(!dropped.healDue(62000, after, gap));
+    assert(w.quietForMs(62000) == 60000);
+    w.healed(62000);
+    // The reconnect came and went and nothing answers still: the next is due a
+    // gap after the first, although a quiet minute has passed sooner.
+    w.link(false, 62500);
+    w.link(true, 65000);
+    for (int i = 0; i < 20; ++i) w.invitationUnanswered();
+    assert(!w.healDue(125000, after, gap) && !w.healDue(181999, after, gap));
+    assert(w.healDue(182000, after, gap));
+    // A quiet minute with fewer than two invitations given up - a FlowLocal
+    // that answers, or a host with nothing to invite - is not a dead link.
+    w.linkUp(200000);
+    w.invitationUnanswered();
+    assert(!w.healDue(400000, after, gap));
+    // A session joins: not quiet, and the count starts over. Its end starts a
+    // quiet spell of its own; given-up invitations count only after it.
+    w.invitationUnanswered();
+    w.sessionUp();
+    w.invitationUnanswered();   // one given up while a session is up
+    assert(w.unansweredCount() == 0 && !w.healDue(500000, after, gap));
+    w.sessionsDown(500000);
+    w.invitationUnanswered(); w.invitationUnanswered();
+    assert(!w.healDue(559999, after, gap) && w.healDue(560000, after, gap));
+    // A second end report inside the spell does not restart it, and neither
+    // does a read of a link that stayed up.
+    w.sessionsDown(550000);
+    w.link(true, 555000);
+    assert(w.healDue(560000, after, gap));
+    // FlowLocal gone for 3 minutes with the panel on (the laptop shut down):
+    // the link drops at 610 s, the session ends on the library's clock sync a
+    // minute later, and an invitation is given up every ~4 s after that. None
+    // of it counts, and the link coming back - read by pump() before the
+    // frame task has served the connect edge - starts the spell over: nothing
+    // is due as it comes back, only a quiet minute and two refusals later.
+    LinkWatch away;
+    away.linkUp(600000);
+    away.sessionUp();
+    away.link(false, 610000);
+    away.sessionsDown(670000);
+    for (uint32_t t = 674000; t <= 790000; t += 4000) away.invitationUnanswered();
+    assert(away.unansweredCount() == 0 && !away.healDue(790000, after, gap));
+    away.link(true, 790000);
+    assert(!away.healDue(790000, after, gap) && !away.healDue(790002, after, gap));
+    away.invitationUnanswered(); away.invitationUnanswered();
+    assert(!away.healDue(849999, after, gap) && away.healDue(850000, after, gap));
+    // millis() wrapping inside the spell.
+    LinkWatch wrap;
+    wrap.linkUp(0xFFFFF000u);
+    wrap.invitationUnanswered(); wrap.invitationUnanswered();
+    assert(!wrap.healDue(0xFFFFF000u + after - 1, after, gap));
+    assert(wrap.healDue(0xFFFFF000u + after, after, gap));
+    // A NO (PF_MIDI_REINVITE_ON_REJECTION) is an answer: the link carried
+    // packets both ways just then. What went unanswered before it no longer
+    // counts, and the spell starts over from it - two refusals a minute apart
+    // are never a dead link. Given-up invitations after it count again.
+    LinkWatch no;
+    no.linkUp(0);
+    no.invitationUnanswered(); no.invitationUnanswered();
+    assert(no.healDue(60000, after, gap));
+    no.hostAnswered(50000);
+    assert(no.unansweredCount() == 0 && no.quietForMs(60000) == 10000 && !no.healDue(60000, after, gap));
+    no.invitationUnanswered(); no.invitationUnanswered();
+    assert(!no.healDue(109999, after, gap) && no.healDue(110000, after, gap));
+    // With a session up it is not a spell at all: nothing starts.
+    no.sessionUp();
+    no.hostAnswered(120000);
+    assert(no.quietForMs(200000) == 0 && !no.healDue(200000, after, gap));
+    puts("rtp retry: 3 attempts and 1 s after an end keep one invitation per host; self-heal after a quiet spell with 2 unanswered, 2 min apart, the spell restarted as a down link comes back and by a NO");
+  }
+
+  // The runtime switch and NVS (PF_MIDI_SESSION_LOCKED, core_midi.h). Last,
+  // because loadSettings() also puts every gain back to its default.
+  {
+    nvsPresent = true; nvsOn = false;   // "off" saved on /midi (or by another build)
+    loadSettings();
+#if PF_MIDI_SESSION_LOCKED
+    // Not read: the build's MIDI is on, and cannot be switched off. The
+    // refusal writes nothing; switching it on is not a change and succeeds.
+    assert(runtimeEnabled);
+    assert(!setRuntimeEnabled(false) && runtimeEnabled && !nvsOn);
+    assert(setRuntimeEnabled(true) && runtimeEnabled && nvsOn);
+    assert(!setRuntimeEnabled(false) && runtimeEnabled && nvsOn);
+    puts("session locked: a saved off is not read, switching off is refused and writes nothing");
+#else
+    // Every edition: the saved switch is the answer, both ways, persisted.
+    assert(!runtimeEnabled);
+    assert(setRuntimeEnabled(true) && runtimeEnabled && nvsOn);
+    assert(setRuntimeEnabled(false) && !runtimeEnabled && !nvsOn);
+    nvsOn = true; loadSettings(); assert(runtimeEnabled);
+#endif
+    nvsPresent = false;
+  }
+  puts("PASS: 200000 ordered cross-thread events, bounded overflow, absolute/relative/note no-echo, physical output, program change resent on host arrival, rtp sessions counted once by ssrc, given-up invitations kept apart from sessions, invite clock and first delay, rejoin ends everything, short invitations and retry after an end, a NO and a BY before the join re-invite in 1 s, the guard as a property over three compositions, the exhibit's clock-sync and heal numbers, Wi-Fi self-heal clock, runtime switch and NVS, lane-held knobs with PF_MIDI_OUT_LANE_ABSOLUTE=" PF_MIDI_TEST_FLAG ", PF_MIDI_SESSION_LOCKED=" PF_MIDI_TEST_LOCK);
 }
