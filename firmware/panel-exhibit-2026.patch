+static constexpr uint32_t ip4(uint32_t a, uint32_t b, uint32_t c, uint32_t d) { return a | b << 8 | c << 16 | d << 24; }
+class IPAddress {
+  uint32_t raw = 0;
+public:
+  IPAddress() = default;
+  IPAddress(uint32_t a) : raw(a) {}
+  IPAddress(uint8_t a, uint8_t b, uint8_t c, uint8_t d) : raw(ip4(a, b, c, d)) {}
+  operator uint32_t() const { return raw; }
+  bool operator==(const IPAddress& o) const { return raw == o.raw; }
+  bool operator!=(const IPAddress& o) const { return raw != o.raw; }
+  bool fromString(const char* text) {
+    unsigned a, b, c, d;
+    char tail;
+    if (!text || sscanf(text, "%u.%u.%u.%u%c", &a, &b, &c, &d, &tail) != 4 || a > 255 || b > 255 || c > 255 || d > 255)
+      return false;
+    raw = ip4(a, b, c, d);
+    return true;
+  }
+  bool fromString(const String& text) { return fromString(text.c_str()); }
+  String toString() const {
+    char buf[16];
+    snprintf(buf, sizeof buf, "%u.%u.%u.%u", raw & 255u, (raw >> 8) & 255u, (raw >> 16) & 255u, raw >> 24);
+    return String(buf);
+  }
+};
