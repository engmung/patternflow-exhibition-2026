diff --git a/firmware/patternflow/features/exhibit/exhibit_pulse.h b/firmware/patternflow/features/exhibit/exhibit_pulse.h
new file mode 100644
index 0000000..9fba43e
--- /dev/null
+++ b/firmware/patternflow/features/exhibit/exhibit_pulse.h
@@ -0,0 +1,216 @@
+// ═══════════════════════════════════════════════════════════
+// PatternFlow - the exhibit: a note when something lands
+//
+// The gallery wanted the gecko's footsteps. The sound is a sample in Ableton
+// Live on the laptop under the desk, and the only honest way to make a sample
+// land on a step is to let the panel say when the step happened: the picture
+// is what a visitor sees, the walk runs at whatever K3 is set to, and a clock
+// on the laptop cannot know either. So the pattern that draws the step marks
+// it, and this turns the mark into a MIDI note in the same frame.
+//
+// ── The seam ────────────────────────────────────────────────────────────
+//
+// A pattern raises bits in a flag of its own (PF_EXHIBIT_PULSE in
+// exhibit_presets.h says which variable and which notes) and knows nothing
+// else - not this file, not MIDI. core_exhibit.h reads the flag of the
+// pattern that is on screen from its drawOverlay hook, which the sketch calls
+// in the same frame, a few microseconds after that frame's update() drew it:
+//
+//   updateActivePattern -> drawActivePattern -> PFFeatures::drawOverlay
+//
+// so the note leaves the panel with the picture rather than a frame behind
+// it, and the four places the sketch does not reach that line - asleep, the
+// console's calibration card, a module still loading, SELECT and the device's
+// own screens - are all places where the pattern did not draw either.
+//
+// ── Where the bytes go ──────────────────────────────────────────────────
+//
+// Nowhere this feature knows. A composition that wants these notes sent
+// defines PF_EXHIBIT_PULSE_SINK as a function taking three MIDI bytes
+// (status, data1, data2) before it includes this feature, and the composition
+// is where the midi feature's name appears - here, features do not know each
+// other (firmware/toolchain/check_boundaries.py, R4). The exhibit build wires
+// it to the same emit() the knob CCs and the button notes go out by, so these
+// notes share the session, the transports, the tx counter and the /midi
+// page's switch: firmware/bundles/exhibit/features_local.h, which is also the
+// only file that knows both features are in this image.
+//
+// Without that define the whole file is empty and every call below is a
+// no-op: a composition carrying the exhibit and no MIDI compiles to the
+// same bytes it did before this existed.
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+
+#include <Arduino.h>
+
+#include "exhibit_config.h"
+#include "exhibit_presets.h"
+
+namespace PatternflowExhibitPulse {
+
+#ifdef PF_EXHIBIT_PULSE_SINK
+
+static_assert(PF_EXHIBIT_PULSE_CHANNEL >= 1 && PF_EXHIBIT_PULSE_CHANNEL <= 16,
+              "PF_EXHIBIT_PULSE_CHANNEL is a MIDI channel, 1..16");
+static_assert(PF_EXHIBIT_PULSE_VELOCITY >= 1 && PF_EXHIBIT_PULSE_VELOCITY <= 127,
+              "PF_EXHIBIT_PULSE_VELOCITY is a MIDI velocity, 1..127 (0 would be a note-off)");
+static_assert(PF_EXHIBIT_PULSE_MS > 0, "PF_EXHIBIT_PULSE_MS is how long the note is held");
+
+// The status nibble is 0-based; the channel people say out loud is 1-based.
+constexpr uint8_t NOTE_ON = (uint8_t)(0x90 | ((PF_EXHIBIT_PULSE_CHANNEL - 1) & 0x0F));
+constexpr uint8_t NOTE_OFF = (uint8_t)(0x80 | ((PF_EXHIBIT_PULSE_CHANNEL - 1) & 0x0F));
+
+// ── The list, as a table ────────────────────────────────────────────────
+struct Row {
+  void (*setup)();   // identifies the pattern's row in PF_EXHIBIT_LIST, as the captions do
+  uint8_t* flag;
+  uint8_t note[2];
+};
+
+#define PF_EXHIBIT_PULSE_AS_ROW_(ns, flag, noteA, noteB) \
+  {ns::setup, (uint8_t*)&(flag), {(uint8_t)(noteA), (uint8_t)(noteB)}},
+#define PF_EXHIBIT_PULSE_CHECK_(ns, flag, noteA, noteB)                                       \
+  static_assert(sizeof(flag) == 1, "PF_EXHIBIT_PULSE: " #flag " must be a one-byte flag");    \
+  static_assert((noteA) >= 0 && (noteA) <= 127 && (noteB) >= 0 && (noteB) <= 127,             \
+                "PF_EXHIBIT_PULSE: " #ns "'s notes are MIDI notes, 0..127");
+PF_EXHIBIT_PULSE(PF_EXHIBIT_PULSE_CHECK_)
+// The last row is a terminator, so an empty list still compiles.
+inline const Row ROWS[] = {PF_EXHIBIT_PULSE(PF_EXHIBIT_PULSE_AS_ROW_){nullptr, nullptr, {0, 0}}};
+constexpr int SLOTS = (int)(sizeof(ROWS) / sizeof(ROWS[0]));
+constexpr int COUNT = SLOTS - 1;
+
+// Which slot of the exhibit list each row is, resolved once in begin(); -1
+// for a row naming a pattern the list does not carry.
+inline int rowSlot[SLOTS] = {};
+
+// ── Note-offs, waiting ──────────────────────────────────────────────────
+// One frame can start at most one note per bit, and a note is held for
+// PF_EXHIBIT_PULSE_MS - about two frames. Four is already more than can be
+// alive at once; the overflow arm below is there so a build with a longer
+// hold, or a pattern with more bits, degrades into a shorter note rather
+// than into a note nobody ever releases.
+constexpr int PENDING = 4;
+struct Pending {
+  bool busy;
+  uint8_t note;
+  uint32_t dueMs;
+};
+inline Pending pending[PENDING] = {};
+
+inline void send(uint8_t status, uint8_t note, uint8_t velocity) {
+  PF_EXHIBIT_PULSE_SINK(status, note, velocity);
+}
+
+inline void release(Pending& p) {
+  p.busy = false;
+  send(NOTE_OFF, p.note, 0);
+}
+
+inline void noteOn(uint8_t note, uint32_t now) {
+  send(NOTE_ON, note, (uint8_t)PF_EXHIBIT_PULSE_VELOCITY);
+  // One note-off per note: a note struck again while its release is still
+  // waiting pushes that release out instead of taking a second slot, so the
+  // second strike cannot be cut short by the first one's note-off.
+  for (auto& p : pending) {
+    if (p.busy && p.note == note) {
+      p.dueMs = now + (uint32_t)PF_EXHIBIT_PULSE_MS;
+      return;
+    }
+  }
+  for (auto& p : pending) {
+    if (!p.busy) {
+      p.busy = true;
+      p.note = note;
+      p.dueMs = now + (uint32_t)PF_EXHIBIT_PULSE_MS;
+      return;
+    }
+  }
+  // Full: release whatever has been down longest, now, and take its slot.
+  Pending* oldest = &pending[0];
+  for (auto& p : pending) {
+    if ((int32_t)(p.dueMs - oldest->dueMs) < 0) oldest = &p;
+  }
+  release(*oldest);
+  oldest->busy = true;
+  oldest->note = note;
+  oldest->dueMs = now + (uint32_t)PF_EXHIBIT_PULSE_MS;
+}
+
+// ── What core_exhibit.h calls ───────────────────────────────────────────
+
+// Match each row to its slot in the exhibit list by setup() pointer - the
+// same identity the registry check uses - so a row naming a pattern that was
+// taken out of PF_EXHIBIT_LIST says so on the serial port instead of sounding
+// under somebody else's picture.
+inline void begin() {
+  for (int i = 0; i < COUNT; i++) {
+    rowSlot[i] = -1;
+    for (int s = 0; s < PFExhibitPresets::COUNT; s++) {
+      if (PFExhibitPresets::CAPTIONS[s].setup == ROWS[i].setup) {
+        rowSlot[i] = s;
+        break;
+      }
+    }
+    if (rowSlot[i] < 0) {
+      Serial.printf("[EXHIBIT] PF_EXHIBIT_PULSE row %d names a pattern that is not in "
+                    "PF_EXHIBIT_LIST - it will never sound\n", i);
+    }
+  }
+  if (COUNT > 0) {
+    Serial.printf("[EXHIBIT] %d pattern(s) send notes on MIDI channel %d, velocity %d, %d ms\n",
+                  COUNT, (int)PF_EXHIBIT_PULSE_CHANNEL, (int)PF_EXHIBIT_PULSE_VELOCITY,
+                  (int)PF_EXHIBIT_PULSE_MS);
+  }
+}
+
+// Every flag dropped without sounding: the pattern that raised one has left
+// the screen, or the panel has stopped drawing.
+inline void clearAll() {
+  for (int i = 0; i < COUNT; i++) *ROWS[i].flag = 0;
+}
+
+// The frame that pattern just drew. `slot` is its place in the exhibit list,
+// or -1 for anything else on the panel - Origin, a module, a pattern the
+// console picked - which flags nothing and sounds nothing.
+inline void onFrame(int slot, uint32_t now) {
+  if (slot < 0) return;
+  for (int i = 0; i < COUNT; i++) {
+    if (rowSlot[i] != slot) continue;
+    const uint8_t bits = *ROWS[i].flag;
+    if (bits == 0) return;
+    *ROWS[i].flag = 0;
+    if (bits & 1) noteOn(ROWS[i].note[0], now);
+    if (bits & 2) noteOn(ROWS[i].note[1], now);
+    return;
+  }
+}
+
+// Every frame, whatever is on the panel and whether or not it is drawing: a
+// note that is down has to come up again even if the picture stopped.
+inline void service(uint32_t now) {
+  for (auto& p : pending) {
+    if (p.busy && (int32_t)(now - p.dueMs) >= 0) release(p);
+  }
+}
+
+// Everything down comes up at once: the panel is going to sleep and the
+// frames that would have released these notes are not coming.
+inline void flush() {
+  for (auto& p : pending) {
+    if (p.busy) release(p);
+  }
+}
+
+#else   // no sink: a composition that does not carry a way to send them
+
+inline void begin() {}
+inline void clearAll() {}
+inline void onFrame(int, uint32_t) {}
+inline void service(uint32_t) {}
+inline void flush() {}
+
+#endif
+
+}  // namespace PatternflowExhibitPulse
