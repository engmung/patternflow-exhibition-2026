+// invitation. The model holds the invitation open from sendInvite() until it
+// joins, is given up, is refused (NO) or is ended by the host's BY, on the
+// library's own timeline - attempts a little over a second apart, the give-up
+// a little over a second after the last, the data half starting at the control
+// OK, which can come just before the control half would be given up. Fates and
+// timings are random. inviteIfDue() must never send while the model still
+// holds the last invitation open; and how long each end leaves the host
+// uninvited is measured, reported or not.
+struct RtpKnobs {
+  uint32_t period;      // REINVITE_MS
+  uint32_t firstDelay;  // PF_MIDI_FIRST_INVITE_DELAY_MS
+  uint32_t afterEnd;    // PF_MIDI_REINVITE_AFTER_END_MS
+  uint32_t attempts;    // the library's MaxSessionInvitesAttempts
+  bool rejection;       // PF_MIDI_REINVITE_ON_REJECTION
+};
+struct GuardRun {
+  uint32_t invites = 0, joins = 0, silentEnds = 0;
+  uint32_t worstAfterReported = 0;   // an end that was reported -> the next invitation
+  uint32_t worstAfterSilent = 0;     // a NO nothing reported -> the next invitation
+  uint32_t longestOpen = 0;          // the longest the model held one invitation open
+};
+template<uint32_t Window>
+static GuardRun guardHolds(const RtpKnobs& k, uint32_t seed, uint32_t durationMs) {
+  using Rtp = RtpSessions<2, Window>;
+  GuardRun run;
+  const uint32_t host = 0x0142A8C0u, hostSsrc = 0x5A17C0DEu;
+  auto pick = [&seed](uint32_t n) { seed = seed * 1664525u + 1013904223u; return (seed >> 8) % n; };
+  // A round trip: mostly quick, sometimes the slowest that still lands before
+  // the next attempt.
+  auto rtt = [&pick]() -> uint32_t { const uint32_t r = pick(4); return r == 0 ? 1000 : r == 1 ? 1 + pick(1000) : 1 + pick(20); };
+  enum class Fate { Join, GiveUpControl, GiveUpData, RefuseControl, RefuseData, ByeEarly };
+  Rtp rtp;
+  // The library's side.
+  bool open = false, session = false;
+  Fate fate = Fate::Join;
+  uint32_t openedAt = 0, fateAt = 0, sessionEndsAt = 0;
+  // core_midi_rtp.h's side.
+  uint32_t clock = Rtp::clockDueIn(1000, k.period, k.firstDelay);
+  bool restart = false;
+  bool waiting = false, waitingSilent = false;   // an end the next invitation is measured from
+  uint32_t waitingSince = 0;
+  // The disconnect handler's "what comes next".
+  auto react = [&](End end, uint32_t at) {
+    const bool nobody = rtp.size() == 0;
+    if (end == End::InvitationGivenUp || end == End::InvitationRejected) {
+      if (k.afterEnd) clock = Rtp::clockDueIn(at, k.period, k.afterEnd);
+    } else if (end == End::Session && nobody) {
+      if (k.afterEnd) restart = true;
+    } else if (end == End::NeverJoined && nobody && k.rejection) {
+      restart = true;
+    }
+    waiting = true; waitingSilent = false; waitingSince = at;
+  };
+  const uint32_t end = 1000 + durationMs;
+  for (uint32_t t = 1000; t < end; ++t) {
+    // pump(): what the last pass's reports asked for comes first
+    // (restartSessions(): the library's list ended and emptied, the guard
+    // dropped).
+    if (restart) {
+      open = false; session = false;
+      rtp.allEnded();
+      clock = Rtp::clockDueIn(t, k.period, k.afterEnd);
+      restart = false;
+    }
+    // midi.read(): the library's reports, on the same task.
+    if (session && t >= sessionEndsAt) { session = false; react(rtp.ended(hostSsrc), t); }
+    if (open && t >= fateAt) {
+      open = false;
+      run.longestOpen = std::max(run.longestOpen, t - openedAt);
+      switch (fate) {
+        case Fate::Join: {
+          const auto joined = rtp.joined(hostSsrc);
+          assert(joined == Rtp::Join::Added);
+          (void)joined;
+          session = true; sessionEndsAt = t + 500 + pick(30000); ++run.joins;
+          break;
+        }
+        case Fate::GiveUpControl: rtp.invitationGivenUp(); react(rtp.ended(0), t); break;
+        case Fate::GiveUpData: rtp.invitationGivenUp(); react(rtp.ended(hostSsrc), t); break;
+        case Fate::RefuseControl:
+        case Fate::RefuseData:
+          if (k.rejection) {
+            rtp.invitationRejected();
