+// ═══════════════════════════════════════════════════════════
+// PatternFlow - the exhibit, as a feature
+//
+// One unattended panel for visitors: K4 switches among the exhibit's
+// compiled-in patterns, K1-K3 are one position each that every pattern (and,
+// through the midi feature, the sound) reads, the long-press screens stay
+// shut, an idle panel returns to its default pattern with the knobs at their
+// starts, and a caption names the artist after each switch. The behaviour is
+// core_exhibit.h; the patterns and captions are exhibit_presets.h; the
+// tunables are exhibit_config.h.
+//
+// Hooks: setup, onNetwork, loop, fillInput, onUserInput, takePattern,
+// onSleep, appendStatus, drawOverlay. One route and no page: /api/exhibit
+// turns the captions on or off (core_exhibit_http.h). Deliberately no row on
+// the device's NETWORK screen (no shortName): there is nothing a visitor
+// should switch.
+//
+// It also sounds the moments a pattern marks - the gecko's footfalls - as
+// MIDI notes, in the frame the pattern drew them (exhibit_pulse.h, the
+// PF_EXHIBIT_PULSE list in exhibit_presets.h, the PF_EXHIBIT_PULSE_* values
+// in exhibit_config.h). Where those three bytes go is the composition's to
+// say: it defines PF_EXHIBIT_PULSE_SINK, and a composition that defines
+// nothing compiles all of it away. This feature still names no other.
+//
+// Put it FIRST in a composition's PF_FEATURE_LIST - its fillInput has to see
+// the physical frame before another feature merges remote input into it.
+// bundles/exhibit/features_local.h says why in full. For the sound to follow
+// the knob positions, the composition's midi feature needs
+// PF_MIDI_OUT_LANE_ABSOLUTE 1 (bundles/exhibit/overrides.h); this feature
+// only puts the positions in the frame, and names no other feature.
+//
+// License: MIT
+// ═══════════════════════════════════════════════════════════
+#pragma once
+#include "../pf_feature.h"
+#include "core_exhibit.h"
+#include "core_exhibit_http.h"
+
+namespace PFFeatureExhibit {
+
+inline const PFFeature descriptor = {
+    "exhibit",
+    "exhibit",     // cap - /api/status says this panel is an exhibit build
+    PatternflowExhibit::setup,
+    PatternflowExhibitHttp::begin,   // onNetwork - /api/exhibit
+    PatternflowExhibit::loop,
+    nullptr,       // observeFrame
+    PatternflowExhibit::fillInput,
+    PatternflowExhibit::onUserInput,
+    nullptr,       // claimsPattern - only asks, so the console can still pick
+    PatternflowExhibit::takePattern,
+    PatternflowExhibit::onSleep,
+    nullptr,       // requestSleep
+    nullptr,       // shortName - not listed on the NETWORK screen
+    nullptr,       // isRuntimeEnabled
+    nullptr,       // setRuntimeEnabled
+    PatternflowExhibit::appendStatus,
+    PatternflowExhibit::drawOverlay,   // the caption; on/off at run time
+    nullptr,       // navPath
+    nullptr,       // navLabel
+    nullptr,       // navDesc
+    nullptr,       // composeFrame
+    nullptr,       // handleSelectInput
+    nullptr,       // drawSelect
+    nullptr,       // decorateSelect
+};
+
+}  // namespace PFFeatureExhibit
