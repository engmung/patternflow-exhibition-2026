+#define PF_MIDI_TEST_STR2(x) #x
+#define PF_MIDI_TEST_STR(x) PF_MIDI_TEST_STR2(x)
+#define PF_MIDI_TEST_FLAG PF_MIDI_TEST_STR(PF_MIDI_OUT_LANE_ABSOLUTE)
+#define PF_MIDI_TEST_LOCK PF_MIDI_TEST_STR(PF_MIDI_SESSION_LOCKED)
