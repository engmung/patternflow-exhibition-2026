+#if !defined(EXHIBIT_PF_MIDI_INVITE_ATTEMPTS) || !defined(EXHIBIT_PF_MIDI_REINVITE_AFTER_END_MS) || \
+    !defined(EXHIBIT_PF_MIDI_FIRST_INVITE_DELAY_MS) || !defined(EXHIBIT_PF_MIDI_REINVITE_MS) ||      \
