# One folder a case (README.md). What a case keeps out of git is listed under it.

# ── exhibition_2026 ─────────────────────────────────────────────────────
# The two clones it builds from are their own repositories (branch exhibit-2026 each).
/exhibition_2026/patternflow/
/exhibition_2026/flowlocal/
# Live auto-backups of the set
/exhibition_2026/set Project/Backup/
# Pattern renders are regenerated by tools/patterns/run.sh render.
/exhibition_2026/patterns/**/renders/
/exhibition_2026/patterns/.pf-runtime.js
# The flasher build installs esptool-js and esbuild here.
/exhibition_2026/tools/flasher/node_modules/

# ── ensemble ────────────────────────────────────────────────────────────
# The Patternflow checkout the panel image is built in (ensemble/panel/install.py).
/patternflow/
# Pattern packs and backups that ensemble/tools/panels.py writes where it runs.
/pack-all/
/pack-*/
/pattern-backup/
/panels.txt

# ── everywhere ──────────────────────────────────────────────────────────
# Temporary secret handed between steps - never commit.
.ap_pass_tmp
__pycache__/
*.pyc
Thumbs.db
desktop.ini
